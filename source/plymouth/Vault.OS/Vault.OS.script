# Vault.OS plymouth script — rotating 111 + phosphor progress
Window.SetBackgroundTopColor(0.027, 0.031, 0.027);
Window.SetBackgroundBottomColor(0.027, 0.031, 0.027);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth()/2 - logo.image.GetWidth()/2);
logo.sprite.SetY(Window.GetHeight()/2 - logo.image.GetHeight()/2 - 40);
logo.angle = 0;

progress.image = Image("progress.png");
progress.sprite = Sprite();
progress.sprite.SetPosition(Window.GetWidth()/2 - progress.image.GetWidth()/2, Window.GetHeight()*0.78, 0);

fun refresh_callback() {
  logo.angle = logo.angle + 0.04;
  rotated = logo.image.Rotate(logo.angle);
  logo.sprite.SetImage(rotated);
  logo.sprite.SetX(Window.GetWidth()/2 - rotated.GetWidth()/2);
  logo.sprite.SetY(Window.GetHeight()/2 - rotated.GetHeight()/2 - 40);
}

Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback(duration, progress) {
  if (progress_image) {
    w = progress.image.GetWidth() * progress;
    cropped = progress.image.Scale(w > 1 ? w : 1, progress.image.GetHeight());
    progress.sprite.SetImage(cropped);
  }
}
Plymouth.SetBootProgressFunction(progress_callback);

message.sprite = Sprite();
message.sprite.SetPosition(0, Window.GetHeight()*0.72, 0);
fun message_callback(text) {
  img = Image.Text(text, 0.10, 1.0, 0.42, 1.0, "Share Tech Mono 10");
  message.sprite.SetImage(img);
  message.sprite.SetX(Window.GetWidth()/2 - img.GetWidth()/2);
}
Plymouth.SetMessageFunction(message_callback);
