# Vault.OS firmware POST — full-screen static splash (user-specified boot process)
Window.SetBackgroundTopColor(0.027, 0.035, 0.047);
Window.SetBackgroundBottomColor(0.027, 0.035, 0.047);

fw = Image("firmware.png");
fw = fw.Scale(Window.GetWidth(), Window.GetHeight());
bg = Sprite(fw);
bg.SetX(0);
bg.SetY(0);
bg.SetZ(-10000);
