[Settings]
gtk-theme-name=Vault.OS
gtk-icon-theme-name=Vault.OS
gtk-font-name=Share Tech Mono 10
gtk-cursor-theme-name=Vault.OS
gtk-cursor-theme-size=24
gtk-application-prefer-dark-theme=1
gtk-xft-antialias=1
