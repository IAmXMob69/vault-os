#!/bin/sh
# Installed to /usr/lib/xfce4-screensaver/vaultos-arch-spin
# xfce4-screensaver runs this as the logged-in user, so resolve the runner
# from that user's home at run time (no home path baked in at install).
# Lock/saver spin only; the terminal phosphor dial never controls it.
HOME="${HOME:-$(getent passwd "$(id -un)" | cut -d: -f6)}"
export HOME
run="$HOME/.local/bin/vaultos-spin-lock-run"
[ -x "$run" ] && exec "$run" "$@"
run="$(command -v vaultos-spin-lock-run 2>/dev/null)" && [ -n "$run" ] && exec "$run" "$@"
exit 0
