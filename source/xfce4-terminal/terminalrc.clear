# Vault.OS xfce4-terminal
# ANSI 0–15 from tokens.css — foreground #1AFF6B, background #070807.
# CLEAR: sharp phosphor only.
# Mode: vaultos-terminal-phosphor {full|reduced|clear}

[Configuration]
Font=Share Tech Mono 11
FontUseSystem=FALSE
FontAllowBold=TRUE
ColorUseTheme=FALSE
ColorForeground=#1AFF6B
ColorBackground=#070807
ColorCursor=#1AFF6B
ColorCursorForeground=#070807
ColorCursorUseDefault=FALSE
ColorBold=#66FF9C
ColorBoldUseDefault=FALSE
ColorBoldIsBright=TRUE
ColorSelection=#66FF9C
ColorSelectionBackground=#0E8A3A
ColorSelectionUseDefault=FALSE
ColorPalette=#070807;#C41E3A;#0E8A3A;#FFB000;#2A332A;#C41E3A;#1AFF6B;#8A8F86;#121612;#C41E3A;#1AFF6B;#FFB000;#8A8F86;#C41E3A;#1AFF6B;#C7C9C5
MiscCursorShape=TERMINAL_CURSOR_SHAPE_BLOCK
MiscCursorBlinks=FALSE
MiscMenubarDefault=FALSE
MiscToolbarDefault=FALSE
MiscBell=FALSE
MiscBellUrgent=TRUE
MiscDefaultGeometry=100x32
MiscMouseAutohide=FALSE
MiscSlimTabs=FALSE
MiscTabCloseButtons=TRUE
ScrollingBar=TERMINAL_SCROLLBAR_RIGHT
ScrollingOnOutput=FALSE
ScrollingOnKeystroke=TRUE
ScrollingLines=10000
TabActivityColor=#C41E3A
TitleInitial=ROBCO 76
TitleMode=TERMINAL_TITLE_REPLACE
BackgroundMode=TERMINAL_BACKGROUND_SOLID
BackgroundImageFile=$HOME/.local/share/Vault.OS/scanline.png
BackgroundImageStyle=TERMINAL_BACKGROUND_STYLE_TILED
BackgroundImageShading=1.000000
BackgroundDarkness=1.000000
