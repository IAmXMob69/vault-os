#!/usr/bin/env bash
# Guided Vault.OS installer. Will not partition anything unless argv is exactly:
#   INSTALL TO /dev/DISK CONFIRMED
# Example: vaultos-install 'INSTALL TO /dev/sdb CONFIRMED'
set -euo pipefail

die() { echo "vaultos-install: $*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Vault.OS installer (Arch derivative).

This script wipes the named disk. It refuses to run unless the first argument
is exactly:

  INSTALL TO /dev/DISK CONFIRMED

Example (only from the live ISO, never against a disk you did not name):

  vaultos-install 'INSTALL TO /dev/sdb CONFIRMED'

It will:
  - partition that disk (GPT: 1G ESP + rest root ext4)
  - pacstrap base + desktop (XFCE/LightDM) when those lists are on the live medium
  - install the Vault.OS overlay (os-release, units, vaultos CLI)
  - systemd-boot on the ESP
  - set the root password
  - leave first boot to create YOUR login account (any username)

It will NOT run if:
  - the confirmation string is missing or misspelled
  - DISK is empty, missing, or looks like the live ISO (/dev/sr0, /dev/loop)
  - / is already on that disk
EOF
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

conf="${1:-}"
[[ "$conf" =~ ^INSTALL\ TO\ /dev/[A-Za-z0-9]+\ CONFIRMED$ ]] \
  || die "refusing to run. Pass exactly: INSTALL TO /dev/DISK CONFIRMED"

# Live ISO only. Never run from an installed system (this host included).
if [[ ! -d /run/archiso && ! -f /run/archiso/bootmnt ]]; then
  die "not a Vault.OS live ISO session (/run/archiso missing). Refusing to touch disks."
fi
[[ "$(id -u)" -eq 0 ]] || die "need root on the live ISO"

disk="${conf#INSTALL TO }"
disk="${disk% CONFIRMED}"
[[ -b "$disk" ]] || die "$disk is not a block device"
case "$disk" in
  /dev/sr*|/dev/loop*|/dev/ram*|/dev/zram*) die "$disk is not an install target" ;;
esac
root_src=$(findmnt -n -o SOURCE / || true)
[[ "$root_src" != "$disk"* ]] || die "$disk is the running root; abort"
# Never target a disk that currently holds /boot of this session
if findmnt -n /boot >/dev/null 2>&1; then
  boot_src=$(findmnt -n -o SOURCE /boot)
  [[ "$boot_src" != "$disk"* ]] || die "$disk currently has /boot mounted; abort"
fi

echo "Will ERASE $disk and install Vault.OS."
echo "Last chance: Ctrl-C in 5 seconds."
sleep 5

sgdisk --zap-all "$disk"
sgdisk -n1:0:+1G -t1:ef00 -c1:ESP \
       -n2:0:0 -t2:8300 -c2:root "$disk"
if [[ "$disk" == *[0-9] ]]; then
  p1="${disk}p1"; p2="${disk}p2"
else
  p1="${disk}1"; p2="${disk}2"
fi
mkfs.fat -F32 -n VAULTESP "$p1"
mkfs.ext4 -F -L vaultos-root "$p2"
mount "$p2" /mnt
mkdir -p /mnt/boot
mount "$p1" /mnt/boot

mapfile -t extra < <(awk '/^[^#]/ && NF && $1 != "yay" {print}' \
  /usr/lib/vaultos/overlay/packages/packages.base \
  /usr/lib/vaultos/overlay/packages/packages.desktop 2>/dev/null || true)
pacstrap -K /mnt base linux linux-firmware intel-ucode mkinitcpio \
  networkmanager sudo git neovim vim lvm2 \
  efibootmgr dosfstools "${extra[@]+"${extra[@]}"}"
genfstab -U /mnt >>/mnt/etc/fstab

if [[ -d /usr/lib/vaultos ]]; then
  mkdir -p /mnt/usr/lib/vaultos /mnt/usr/lib/systemd/system /mnt/usr/bin \
    /mnt/usr/share/xsessions /mnt/etc/skel /mnt/etc/vaultos
  cp -a /usr/lib/vaultos/. /mnt/usr/lib/vaultos/
  cp -a /usr/lib/systemd/system/vaultos-*.service /mnt/usr/lib/systemd/system/ 2>/dev/null || true
  ln -sfn /usr/lib/vaultos/bin/vaultos /mnt/usr/bin/vaultos
  if [[ -d /usr/lib/vaultos/overlay/skel ]]; then
    cp -a /usr/lib/vaultos/overlay/skel/. /mnt/etc/skel/
  fi
  if [[ -f /usr/lib/vaultos/overlay/xsessions/vaultos.desktop ]]; then
    install -m 0644 /usr/lib/vaultos/overlay/xsessions/vaultos.desktop \
      /mnt/usr/share/xsessions/vaultos.desktop
  fi
  if [[ -f /usr/lib/vaultos/overlay/firstboot.conf.example ]]; then
    install -m 0644 /usr/lib/vaultos/overlay/firstboot.conf.example \
      /mnt/etc/vaultos/firstboot.conf.example
  fi
fi
# Theme files if the live medium has them (optional).
for t in /usr/share/themes/Vault.OS /root/.themes/Vault.OS; do
  [[ -d "$t" ]] && mkdir -p /mnt/usr/share/themes && cp -a "$t" /mnt/usr/share/themes/ && break
done
for t in /usr/share/icons/Vault.OS /root/.icons/Vault.OS; do
  [[ -d "$t" ]] && mkdir -p /mnt/usr/share/icons && cp -a "$t" /mnt/usr/share/icons/ && break
done
if [[ -x /usr/lib/vaultos/overlay/identity-apply.sh ]]; then
  arch-chroot /mnt /usr/lib/vaultos/overlay/identity-apply.sh apply || true
fi
arch-chroot /mnt /bin/bash -s <<'CHROOT'
set -e
ln -sf /usr/share/zoneinfo/UTC /etc/localtime
hwclock --systohc || true
echo 'en_US.UTF-8 UTF-8' >/etc/locale.gen
locale-gen
echo 'LANG=en_US.UTF-8' >/etc/locale.conf
# live hostname is vaultos-live; installed system defaults to vaultos
echo vaultos >/etc/hostname
systemctl enable NetworkManager.service
if [[ -f /usr/lib/systemd/system/vaultos-core.service ]]; then
  systemctl enable vaultos-core.service vaultos-firstboot.service vaultos-firstuser.service
fi
if [[ -f /usr/lib/systemd/system/lightdm.service ]]; then
  systemctl enable lightdm.service
  systemctl set-default graphical.target
  mkdir -p /etc/lightdm/lightdm.conf.d
  cat >/etc/lightdm/lightdm.conf.d/50-vaultos.conf <<'LD'
[Seat:*]
user-session=vaultos
greeter-session=lightdm-gtk-greeter
greeter-hide-users=false
greeter-show-manual-login=true
LD
  mkdir -p /etc/systemd/system/lightdm.service.d
  cat >/etc/systemd/system/lightdm.service.d/vaultos-firstuser.conf <<'LD'
[Unit]
# Do not start the greeter until the wizard has created a login user.
After=vaultos-firstuser.service
Requires=vaultos-firstuser.service
LD
fi
bootctl install
tmp=$(mktemp)
printf '%%wheel ALL=(ALL:ALL) ALL\n' >"$tmp"
if command -v visudo >/dev/null 2>&1; then
  visudo -c -f "$tmp"
fi
install -m 0440 "$tmp" /etc/sudoers.d/wheel
rm -f "$tmp"
CHROOT

echo "Set password for root (recovery only). Your login user is created on first boot."
arch-chroot /mnt passwd
umount -R /mnt
echo "Install finished. Remove the ISO and boot the disk."
echo "First boot will ask you to create your account."
