#!/bin/bash
# Desktop Arch mark autostart.
# Uses the C++ vaultos-mark when it's built, Python spinner otherwise.
# ~/.config/Vault.OS/desktop-spin: boot (default) | full | pulse | static | off
set -euo pipefail
export DISPLAY="${DISPLAY:-:0.0}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}"
MODE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/Vault.OS/desktop-spin"
mode="$(cat "$MODE_FILE" 2>/dev/null || echo boot)"
[ "$mode" = off ] && exit 0
if [ -x "$HOME/.local/bin/vaultos-mark" ]; then
  case "$mode" in
    full|spin) flag=--spin ;;
    pulse) flag=--pulse ;;
    static|reduced) flag=--static ;;
    *) flag=--boot ;;
  esac
  exec "$HOME/.local/bin/vaultos-mark" "$flag" --instance desktop
fi
case "$mode" in
  full) flag=--full ;;
  *) flag=--reduced-phosphor ;;
esac
exec "$HOME/.local/bin/vaultos-spin-arch" "$flag" --instance desktop
