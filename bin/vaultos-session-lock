#!/usr/bin/env bash
# Session lock entry — spin mark then xfce4-screensaver lock.
set -euo pipefail
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}"
HOME="${HOME:-$(getent passwd "$(id -un)" | cut -d: -f6)}"
SPIN="${HOME}/.local/bin/vaultos-spin-lock"
RUN="${HOME}/.local/bin/vaultos-spin-lock-run"
pkill -f "${SPIN}" 2>/dev/null || true
if [[ -x "$RUN" ]]; then
  "$RUN" >/tmp/vaultos-spin-lock.log 2>&1 &
elif [[ -x "$SPIN" ]]; then
  "$SPIN" --full >/tmp/vaultos-spin-lock.log 2>&1 &
fi
exec xfce4-screensaver-command --lock
