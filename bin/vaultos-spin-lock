#!/usr/bin/env python3
"""Vault.OS lock/screensaver — Arch code mark Y-axis spin on vault-black.

Embeds into xfce4-screensaver via Gtk.Plug + $XSCREENSAVER_WINDOW.
Lock/idle default: spin (--full). Static only for Vault.OS-Reduced / --reduced-phosphor.
Unlock chrome (lock.css) stays the opaque plate — this is the saver surface only.
"""
import math
import os
import signal
import subprocess
import sys

import cairo
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib

LOGO = os.path.expanduser("~/.local/share/backgrounds/Vault.OS/arch-logo-code.png")
PERIOD = 8.0
PHOSPHOR_STATE = os.path.expanduser("~/.config/Vault.OS/terminal-phosphor")
VAULT_BLACK = (7 / 255, 8 / 255, 7 / 255, 1.0)


def phosphor_mode():
    try:
        return open(PHOSPHOR_STATE).read().strip().lower() or "reduced"
    except Exception:
        return "reduced"


def theme_name():
    try:
        return subprocess.check_output(
            ["xfconf-query", "-c", "xsettings", "-p", "/Net/ThemeName"],
            stderr=subprocess.DEVNULL,
            text=True,
        ).strip()
    except Exception:
        return ""


def want_animate(force_reduced: bool, force_full: bool) -> bool:
    if force_full:
        return True
    if force_reduced:
        return False
    if theme_name() == "Vault.OS-Reduced":
        return False
    return True


def parse_xid():
    env = os.environ.get("XSCREENSAVER_WINDOW", "").strip()
    if not env:
        return None
    try:
        return int(env, 0)
    except ValueError:
        try:
            return int(env, 16)
        except ValueError:
            return None


class LockSpin(Gtk.DrawingArea):
    def __init__(self, animate: bool):
        super().__init__()
        self.animate = animate
        self.angle = 0.0
        self.set_app_paintable(True)
        self.set_hexpand(True)
        self.set_vexpand(True)
        self.surface = cairo.ImageSurface.create_from_png(LOGO)
        self.lw = self.surface.get_width()
        self.lh = self.surface.get_height()
        self.connect("draw", self.on_draw)
        if self.animate:
            GLib.timeout_add(33, self.tick)

    def tick(self):
        self.angle = (self.angle + (2 * math.pi) * (0.033 / PERIOD)) % (2 * math.pi)
        self.queue_draw()
        return True

    def on_draw(self, _w, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(*VAULT_BLACK)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        alloc = self.get_allocation()
        cx, cy = alloc.width / 2, alloc.height / 2
        target = min(alloc.width, alloc.height) * 0.28
        scale = target / max(self.lw, self.lh, 1)
        cr.save()
        cr.translate(cx, cy)
        if self.animate:
            sx = math.cos(self.angle)
            cr.scale(max(0.08, abs(sx)) * scale, scale)
            if sx < 0:
                cr.scale(-1, 1)
        else:
            cr.scale(scale, scale)
        cr.set_source_surface(self.surface, -self.lw / 2, -self.lh / 2)
        cr.paint()
        cr.restore()
        cr.select_font_face("Share Tech Mono", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(14)
        cr.set_source_rgba(0x8A / 255, 0x8F / 255, 0x86 / 255, 1.0)
        label = "VAULT.OS"
        tw = cr.text_extents(label)[2]
        cr.move_to(cx - tw / 2, cy + target / 2 + 36)
        cr.show_text(label)
        return False


def make_host(embed_xid):
    # xid 0 / None is not a valid XSCREENSAVER_WINDOW — fullscreen Window instead
    if embed_xid:
        try:
            host = Gtk.Plug.new(embed_xid)
        except Exception as e:
            print("Plug.new failed:", e, "→ fullscreen fallback", flush=True)
            embed_xid = None
            host = None
        if embed_xid:
            host.set_app_paintable(True)
            host.connect("delete-event", lambda *_: Gtk.main_quit() or True)
            host.connect("destroy", lambda *_: Gtk.main_quit())
            return host
    host = Gtk.Window()
    host.set_title("Vault.OS Arch Lock")
    host.set_decorated(False)
    host.set_skip_taskbar_hint(True)
    host.set_skip_pager_hint(True)
    host.fullscreen()
    host.set_app_paintable(True)
    host.connect("delete-event", lambda *_: Gtk.main_quit() or True)
    host.connect("destroy", lambda *_: Gtk.main_quit())
    return host


def main():
    force_reduced = "--reduced-phosphor" in sys.argv
    force_full = "--full" in sys.argv or "--force-spin" in sys.argv
    if not os.path.isfile(LOGO):
        print("missing", LOGO, file=sys.stderr)
        return 1
    animate = want_animate(force_reduced, force_full)
    xid = parse_xid()
    print(
        f"vaultos-spin-lock animate={animate} xid={xid} phosphor={phosphor_mode()} theme={theme_name() or '?'}",
        flush=True,
    )

    def cleanup(*_a):
        try:
            Gtk.main_quit()
        except Exception:
            pass

    signal.signal(signal.SIGTERM, cleanup)
    signal.signal(signal.SIGINT, cleanup)
    host = make_host(xid)
    host.add(LockSpin(animate=animate))
    host.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
