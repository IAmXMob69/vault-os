#!/usr/bin/env python3
# Close all application windows (Wnck). Skip panel/desktop.
# FALLBACK: the native port is src/vaultos-close-all (vaultos-close-all).
# When it is built this script hands over to it straight away; set
# VAULTOS_NO_NATIVE=1 to force the Python path. --dry-run lists windows only.
import os
import sys

if os.environ.get("VAULTOS_NO_NATIVE") != "1":
    for _d in (os.environ.get("VAULTOS_NATIVE_DIR"), os.path.expanduser("~/.local/bin")):
        _n = os.path.join(_d, "vaultos-close-all") if _d else ""
        if _n and os.access(_n, os.X_OK):
            os.execv(_n, [_n] + sys.argv[1:])

DRY = "--dry-run" in sys.argv[1:]

os.environ.setdefault("DISPLAY", os.environ.get("DISPLAY", ":0"))
os.environ.setdefault("GDK_BACKEND", "x11")

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Wnck", "3.0")
from gi.repository import Gtk, Wnck, GLib

screen = Wnck.Screen.get_default()
if screen is None:
    sys.stderr.write("no wnck screen\n")
    sys.exit(1)

Gtk.init([])
screen.force_update()

skip_classes = {
    "xfce4-panel",
    "xfdesktop",
    "xfwm4",
    "wrapper-2.0",
    "xfce4-notifyd",
    "notify-osd",
    "plasmashell",
}

closed = 0
for win in list(screen.get_windows() or []):
    try:
        wclass = (win.get_class_group_name() or "").lower()
        if wclass in skip_classes:
            continue
        if any(s in wclass for s in ("panel", "xfdesktop", "notify")):
            continue
        wtype = win.get_window_type()
        if wtype in (
            Wnck.WindowType.DESKTOP,
            Wnck.WindowType.DOCK,
            Wnck.WindowType.SPLASHSCREEN,
            Wnck.WindowType.MENU,
            Wnck.WindowType.TOOLBAR,
            Wnck.WindowType.UTILITY,
        ):
            continue
        if DRY:
            print(f"CLOSE      0x{win.get_xid():08x}  {wclass:<24} {win.get_name() or ''}")
            closed += 1
            continue
        win.close(Gtk.get_current_event_time())
        closed += 1
    except Exception as e:
        sys.stderr.write(f"skip: {e}\n")

if DRY:
    print(f"would close {closed}")
    sys.exit(0)

GLib.timeout_add(200, Gtk.main_quit)
Gtk.main()

try:
    gi.require_version("Notify", "0.7")
    from gi.repository import Notify

    Notify.init("Vault-OS")
    Notify.Notification.new("Close All", f"Closed {closed} window(s)", "nuclear_waste").show()
except Exception:
    pass

print(f"closed {closed}")
