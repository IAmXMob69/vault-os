#!/usr/bin/env bash
# Force Pip-Boy Chromium theme (never stock GTK appearance)
set -euo pipefail

HOME="${HOME:-/home/$USER}"
PREF="$HOME/.config/chromium/Default/Preferences"
EXT_ID="kejkfoiccfnilemcanijoigaomglbkaa"
THEME_SRC="${XDG_DATA_HOME:-$HOME/.local/share}/chromium-extensions/pipboy-nv-theme"
EXT_PATH="$HOME/.config/chromium/Default/Extensions/${EXT_ID}/1.0.2_0"

pgrep -x chromium >/dev/null 2>&1 && exit 0
[[ -f "$PREF" ]] || exit 0
[[ -f "$THEME_SRC/manifest.json" ]] || exit 0

mkdir -p "$EXT_PATH"
cp -f "$THEME_SRC/manifest.json" "$EXT_PATH/manifest.json"

python3 - "$PREF" "$EXT_ID" "$EXT_PATH" <<'PY'
import json, sys, time
pref, ext_id, ext_path = sys.argv[1:4]
with open(pref) as f:
    d = json.load(f)
chrome_ts = str(int((time.time() + 11644473600) * 1_000_000))
manifest = json.loads(open(ext_path + "/manifest.json").read())
settings = d.setdefault("extensions", {}).setdefault("settings", {})
settings[ext_id] = {
    "account_extension_type": 0,
    "active_permissions": {"api": [], "explicit_host": [], "manifest_permissions": [], "scriptable_host": []},
    "commands": {},
    "content_settings": [],
    "creation_flags": 1,
    "disable_reasons": [],
    "from_webstore": False,
    "granted_permissions": {"api": [], "explicit_host": [], "manifest_permissions": [], "scriptable_host": []},
    "incognito_content_settings": [],
    "incognito_preferences": {},
    "location": 4,
    "manifest": manifest,
    "path": ext_path,
    "preferences": {},
    "regular_only_preferences": {},
    "state": 1,
    "was_installed_by_default": False,
    "was_installed_by_oem": False,
    "withholding_permissions": False,
    "first_install_time": chrome_ts,
    "last_update_time": chrome_ts,
}
d.setdefault("extensions", {})["theme"] = {"id": ext_id, "system_theme": 0}
if "autogenerated" in d:
    d["autogenerated"].pop("theme", None)
with open(pref, "w") as f:
    json.dump(d, f, separators=(",", ":"))
print("pipboy chromium theme applied", ext_id)
PY
