#!/usr/bin/env python3
# Force Pip-Boy Chromium theme (never stock GTK appearance)
import json
import os
import subprocess
import sys
import time
from pathlib import Path

home = Path(os.environ.get("HOME") or Path.home())
pref = home / ".config/chromium/Default/Preferences"
ext_id = "kejkfoiccfnilemcanijoigaomglbkaa"
theme_src = Path(os.environ.get("XDG_DATA_HOME", home / ".local/share")) / "chromium-extensions/pipboy-nv-theme"
ext_path = home / ".config/chromium/Default/Extensions" / ext_id / "1.0.2_0"

if subprocess.call(["pgrep", "-x", "chromium"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0:
    sys.exit(0)
if not pref.is_file() or not (theme_src / "manifest.json").is_file():
    sys.exit(0)

ext_path.mkdir(parents=True, exist_ok=True)
manifest_text = (theme_src / "manifest.json").read_text(encoding="utf-8")
(ext_path / "manifest.json").write_text(manifest_text, encoding="utf-8")

with pref.open(encoding="utf-8") as f:
    data = json.load(f)

chrome_ts = str(int((time.time() + 11644473600) * 1_000_000))
manifest = json.loads(manifest_text)
settings = data.setdefault("extensions", {}).setdefault("settings", {})
settings[ext_id] = {
    "account_extension_type": 0,
    "active_permissions": {"api": [], "explicit_host": [], "manifest_permissions": [], "scriptable_host": []},
    "commands": {},
    "content_settings": [],
    "creation_flags": 1,
    "disable_reasons": [],
    "from_webstore": False,
    "granted_permissions": {"api": [], "explicit_host": [], "manifest_permissions": [], "scriptable_host": []},
    "incognito_content_settings": [],
    "incognito_preferences": {},
    "location": 4,
    "manifest": manifest,
    "path": str(ext_path),
    "preferences": {},
    "regular_only_preferences": {},
    "state": 1,
    "was_installed_by_default": False,
    "was_installed_by_oem": False,
    "withholding_permissions": False,
    "first_install_time": chrome_ts,
    "last_update_time": chrome_ts,
}
data.setdefault("extensions", {})["theme"] = {"id": ext_id, "system_theme": 0}
theme = data.setdefault("extensions", {}).setdefault("theme", {})
if theme.get("system_theme") == 1:
    theme["system_theme"] = 0
if "autogenerated" in data:
    data["autogenerated"].pop("theme", None)

with pref.open("w", encoding="utf-8") as f:
    json.dump(data, f, separators=(",", ":"))
print("pipboy chromium theme applied", ext_id)
