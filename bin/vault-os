#!/usr/bin/env bash
# vault-os — production control plane for Vault.OS XFCE stack
set -euo pipefail

readonly VERSION="1.5.19"
readonly CONF_DEFAULT="${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv/vault-os.conf"

export DISPLAY="${DISPLAY:-:0}"
export XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

load_config() {
  THEME_NAME=Vault.OS
  ICON_THEME=Vault.OS
  WM_THEME=Vault.OS
  CURSOR_THEME=Vault.OS
  CURSOR_SIZE=24
  UI_FONT="Share Tech Mono 10"
  MONO_FONT="Share Tech Mono 10"
  TITLE_FONT="Share Tech Mono Bold 10"
  WALLPAPER="$HOME/.local/share/backgrounds/Vault.OS/vault-111-base.png"
  WALLPAPER_FALLBACK="$HOME/.local/share/backgrounds/Vault.OS/vault-111.png"
  PANEL1_POSITION="p=6;x=0;y=0"
  PANEL1_LENGTH=100
  PANEL1_SIZE=28
  PANEL1_AUTOHIDE=0
  PANEL1_BG_IMAGE="$HOME/.local/share/backgrounds/Vault.OS/panel-top.png"
  PANEL2_POSITION="p=10;x=0;y=0"
  PANEL2_LENGTH=100
  PANEL2_SIZE=44
  PANEL2_AUTOHIDE=0
  PANEL2_BG_IMAGE="$HOME/.local/share/backgrounds/Vault.OS/panel-dock.png"
  PANEL_BG_STYLE=2
  PANEL_BG_R=0.047
  PANEL_BG_G=0.059
  PANEL_BG_B=0.047
  PANEL_BG_A=1.0
  PANEL1_ICON_SIZE=16
  PANEL2_ICON_SIZE=32
  INTRO_FILE="$HOME/.local/share/fallout-nv/boot-intro.mp4"
  INTRO_VOLUME=90
  INTRO_ENABLED=0
  LOG_FILE="$HOME/.local/share/fallout-nv/logs/vault-os.log"
  LOCK_DIR="${XDG_RUNTIME_DIR}/vault-os"
  A11Y=0
  A11Y_MOTION=on
  A11Y_TEXT=normal

  if [[ -f "$CONF_DEFAULT" ]]; then
    set +u
    # shellcheck disable=SC1090
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ "$line" =~ ^[[:space:]]*# ]] && continue
      [[ -z "${line// }" ]] && continue
      key="${line%%=*}"
      val="${line#*=}"
      key="${key// /}"
      [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
      # expand $HOME and $XDG_RUNTIME_DIR
      val="${val//\$HOME/$HOME}"
      val="${val//\$XDG_RUNTIME_DIR/$XDG_RUNTIME_DIR}"
      printf -v "$key" '%s' "$val"
    done < "$CONF_DEFAULT"
    set -u
  fi
  mkdir -p "$(dirname "$LOG_FILE")" "$LOCK_DIR" \
    "${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv" \
    "$HOME/.local/state/vault-os"
}

_ts() { date -Iseconds 2>/dev/null || date '+%Y-%m-%dT%H:%M:%S'; }
_rotate_log() {
  [[ -n "${LOG_FILE:-}" && -f "$LOG_FILE" ]] || return 0
  local sz
  sz=$(stat -c '%s' "$LOG_FILE" 2>/dev/null || echo 0)
  if (( sz > 2097152 )); then
    mv -f "$LOG_FILE" "${LOG_FILE}.old" 2>/dev/null || true
  fi
}
log()  { _rotate_log; printf '%s INFO  %s\n' "$(_ts)" "$*" >>"$LOG_FILE"; printf '[vault-os] %s\n' "$*"; }
warn() { _rotate_log; printf '%s WARN  %s\n' "$(_ts)" "$*" >>"$LOG_FILE"; printf '[vault-os] WARN: %s\n' "$*" >&2; }
err()  { _rotate_log; printf '%s ERROR %s\n' "$(_ts)" "$*" >>"$LOG_FILE"; printf '[vault-os] ERROR: %s\n' "$*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }

conf_set() {
  local key="$1" val="$2" conf="${CONF_DEFAULT}"
  mkdir -p "$(dirname "$conf")"
  [[ -f "$conf" ]] || : >"$conf"
  if grep -qE "^${key}=" "$conf" 2>/dev/null; then
    sed -i "s|^${key}=.*|${key}=${val}|" "$conf"
  else
    printf '%s=%s\n' "$key" "$val" >>"$conf"
  fi
}

_gtk_overlay_dir() {
  # Prefer conf/env checkout, then bin-adjacent repo, then ~/Vault.OS
  local cand
  for cand in "${VAULT_OS_ROOT:-}" "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)" "$HOME/Vault.OS"; do
    [[ -n "$cand" && -d "$cand/source/gtk-overlay" ]] && { printf '%s\n' "$cand/source/gtk-overlay"; return 0; }
  done
  printf '%s\n' "$HOME/Vault.OS/source/gtk-overlay"
}


has_share_tech_mono() {
  # File check first (fast, no pipefail issues under set -e)
  [[ -f "$HOME/.local/share/fonts/ShareTechMono/ShareTechMono-Regular.ttf" ]] && return 0
  [[ -f "$HOME/.local/share/fonts/pipboy/ShareTechMono-Regular.ttf" ]] && return 0
  # grep reads to EOF (no -q): with pipefail, -q exiting early can kill
  # fc-list with SIGPIPE and turn a match into "missing".
  if fc-list : family 2>/dev/null | grep -Fi "Share Tech Mono" >/dev/null; then return 0; fi
  if fc-list 2>/dev/null | grep -Fi "ShareTechMono" >/dev/null; then return 0; fi
  return 1
}


_panel_num_ok() { awk -v v="${1:-0}" -v m="${2:-0}" 'BEGIN{ exit !(v+0 >= m) }'; }

_xq_vals_equal() {
  # String match, or numeric match so 100 == 100.000000.
  local a="$1" b="$2"
  [[ "$a" == "$b" ]] && return 0
  [[ "$a" =~ ^-?[0-9]+([.][0-9]+)?$ && "$b" =~ ^-?[0-9]+([.][0-9]+)?$ ]] || return 1
  awk -v a="$a" -v b="$b" 'BEGIN{exit !(a+0==b+0)}'
}

# Native batch client (src/vaultos-xq): one libxfconf connection, compares
# before writing. xq_set/xq_get use it when present and fall back to
# xfconf-query otherwise. VAULTOS_XQ=/path overrides, VAULTOS_XQ= disables.
if [[ -z "${VAULTOS_XQ+x}" ]]; then
  VAULTOS_XQ="$(command -v vaultos-xq 2>/dev/null || true)"
fi
[[ -n "$VAULTOS_XQ" && ! -x "$VAULTOS_XQ" ]] && VAULTOS_XQ=""
_XQ_QUEUE=0
_XQ_LINES=()
_XQ_CMDS=()

# xq_begin ... xq_commit: queue xq_set calls and send them in one batch.
# Only wrap runs of xq_set/xq_get (xq_get flushes first); direct
# xfconf-query calls inside the run would see stale values.
xq_begin() {
  [[ -n "$VAULTOS_XQ" ]] || return 0
  _XQ_QUEUE=1
  _XQ_LINES=()
  _XQ_CMDS=()
}

_xq_flush() {
  ((${#_XQ_LINES[@]})) || return 0
  local lines=("${_XQ_LINES[@]}") cmds=("${_XQ_CMDS[@]}") c
  _XQ_LINES=()
  _XQ_CMDS=()
  printf '%s\n' "${lines[@]}" | "$VAULTOS_XQ" batch 2>/dev/null && return 0
  # Batch failed (xfconfd away, odd type): replay through xfconf-query.
  # Safe to repeat, the fallback skips values that already match.
  for c in "${cmds[@]}"; do
    eval "_xq_set_query $c"
  done
}

xq_commit() {
  _xq_flush
  _XQ_QUEUE=0
}

xq_set() {
  if [[ -n "$VAULTOS_XQ" ]]; then
    if ((_XQ_QUEUE)) && [[ "$*" != *$'\t'* && "$*" != *$'\n'* ]]; then
      local line="set"$'\t'"$1"$'\t'"$2" a=("$@") i
      for ((i=2; i<${#a[@]}; i++)); do
        case "${a[i]}" in
          -t) line+=$'\t'"${a[i+1]}"; i=$((i+1)) ;;
          -s) line+=$'\t'"${a[i+1]}"; i=$((i+1)) ;;
        esac
      done
      _XQ_LINES+=("$line")
      _XQ_CMDS+=("$(printf '%q ' "$@")")
      return 0
    fi
    "$VAULTOS_XQ" set "$@" 2>/dev/null && return 0
  fi
  _xq_set_query "$@"
}

_xq_set_query() {
  # Set in place. Skip when already equal (avoids xfwm/panel reload storms).
  # Create if missing. Only delete+recreate on a type mismatch.
  have xfconf-query || return 0
  local ch="$1" prop="$2"; shift 2
  local vals=() i
  local raw=("$@")
  for ((i=0; i<${#raw[@]}; i++)); do
    if [[ "${raw[i]}" == "-s" ]]; then
      vals+=("${raw[i+1]}")
      i=$((i+1))
    fi
  done
  if ((${#vals[@]} > 0)); then
    local cur=() line
    while IFS= read -r line; do
      [[ -z "$line" || "$line" == "Value is an array"* ]] && continue
      cur+=("$line")
    done < <(xfconf-query -c "$ch" -p "$prop" 2>/dev/null || true)
    if ((${#cur[@]} == ${#vals[@]})); then
      local same=1
      for i in "${!vals[@]}"; do
        if ! _xq_vals_equal "${cur[i]}" "${vals[i]}"; then
          same=0
          break
        fi
      done
      if ((same)); then
        return 0
      fi
    fi
  fi
  if xfconf-query -c "$ch" -p "$prop" "$@" 2>/dev/null; then
    return 0
  fi
  if xfconf-query -c "$ch" -p "$prop" -n "$@" 2>/dev/null; then
    return 0
  fi
  xfconf-query -c "$ch" -p "$prop" -r 2>/dev/null || true
  xfconf-query -c "$ch" -p "$prop" -n "$@" 2>/dev/null || true
}

write_vault_os_env() {
  local dest="$HOME/.config/environment.d/vault-os.conf"
  mkdir -p "$(dirname "$dest")"
  local tmp
  tmp="$(mktemp "${TMPDIR:-/tmp}/vault-os-env.XXXXXX")"
  {
    printf '%s\n' \
      "GTK_THEME=${THEME_NAME}" \
      "QT_QPA_PLATFORMTHEME=qt5ct" \
      "QT_STYLE_OVERRIDE=kvantum" \
      "XCURSOR_THEME=${CURSOR_THEME:-Vault.OS}" \
      "XCURSOR_SIZE=${CURSOR_SIZE:-24}" \
      "GTK_MODULES=canberra-gtk-module" \
      "LIBVA_DRIVER_NAME=iHD" \
      "LIBVA_DRIVERS_PATH=/usr/lib/dri" \
      "MOZ_X11_EGL=1"
    if [[ -f "$dest" ]]; then
      local k
      while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" == *=* ]] || continue
        k="${line%%=*}"
        case "$k" in
          GTK_THEME|QT_QPA_PLATFORMTHEME|QT_STYLE_OVERRIDE|XCURSOR_THEME|XCURSOR_SIZE|GTK_MODULES|LIBVA_DRIVER_NAME|LIBVA_DRIVERS_PATH|MOZ_X11_EGL) continue ;;
        esac
        printf '%s\n' "$line"
      done < "$dest"
    fi
  } >"$tmp"
  mv -f "$tmp" "$dest"
}
xq_get() {
  # Queued sets go out first so the read sees them. A single get costs the
  # same either way (~9 ms), so xfconf-query stays the reader; vaultos-xq
  # only steps in when xfconf-query is missing.
  [[ -n "$VAULTOS_XQ" ]] && _xq_flush
  if ! have xfconf-query && [[ -n "$VAULTOS_XQ" ]]; then
    "$VAULTOS_XQ" get "$1" "$2" 2>/dev/null || true
    return 0
  fi
  have xfconf-query || { echo ""; return 0; }
  xfconf-query -c "$1" -p "$2" 2>/dev/null || true
}

ensure_xfdesktop() {
  # Keep xfdesktop running. Never touch last-image / backdrop — the user
  # owns the wallpaper (Settings → Desktop).
  export DISPLAY="${DISPLAY:-:0}"
  export XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"
  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"

  if pgrep -x xfdesktop >/dev/null 2>&1; then
    return 0
  fi

  warn "xfdesktop not running — starting (wallpaper guard)"
  mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv"
  local lock="${XDG_RUNTIME_DIR}/vault-os/xfdesktop.start.lock"
  mkdir -p "$(dirname "$lock")"
  exec 9>"$lock"
  if ! flock -n 9; then
    sleep 0.5
    pgrep -x xfdesktop >/dev/null 2>&1 && return 0
  fi

  nohup xfdesktop --disable-wm-check \
    >>"${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv/xfdesktop.log" 2>&1 &
  sleep 0.9

  if ! pgrep -x xfdesktop >/dev/null 2>&1; then
    nohup xfdesktop \
      >>"${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv/xfdesktop.log" 2>&1 &
    sleep 0.9
  fi

  if pgrep -x xfdesktop >/dev/null 2>&1; then
    log "xfdesktop started pid=$(pgrep -x xfdesktop | head -1)"
    return 0
  fi
  err "failed to start xfdesktop — see ~/.config/fallout-nv/xfdesktop.log"
  return 1
}

cmd_ensure_desktop() {
  log "ensure desktop (keep xfdesktop running)"
  load_config 2>/dev/null || true
  ensure_xfdesktop
}



intro_mpv_running() {
  # Match mpv by PID + cmdline without killing self; only look at mpv processes
  local pid cmd
  for pid in $(pgrep -x mpv 2>/dev/null || true); do
    cmd=$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)
    case "$cmd" in
      *boot-intro*|*FNVIntro*) return 0 ;;
    esac
  done
  return 1
}

stop_intro_mpv() {
  local pid cmd
  for pid in $(pgrep -x mpv 2>/dev/null || true); do
    cmd=$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)
    case "$cmd" in
      *boot-intro*|*FNVIntro*) kill "$pid" 2>/dev/null || true ;;
    esac
  done
}

cmd_apply() {
  log "apply theme stack ($THEME_NAME / $ICON_THEME / $CURSOR_THEME)"

  # Font fallback if Share Tech Mono missing
  if has_share_tech_mono; then
    UI_FONT="Share Tech Mono 10"
    MONO_FONT="Share Tech Mono 10"
    TITLE_FONT="Share Tech Mono Bold 10"
  elif fc-list : family 2>/dev/null | grep -Fqi "JetBrains Mono"; then
    UI_FONT="JetBrains Mono 10"
    MONO_FONT="JetBrains Mono 10"
    TITLE_FONT="JetBrains Mono Bold 10"
    warn "Share Tech Mono missing — using JetBrains Mono"
  fi

  xq_set xsettings /Net/ThemeName -t string -s "$THEME_NAME"
  xq_set xsettings /Net/IconThemeName -t string -s "$ICON_THEME"
  xq_set xsettings /Gtk/FontName -t string -s "$UI_FONT"
  xq_set xsettings /Gtk/MonospaceFontName -t string -s "$MONO_FONT"
  xq_set xsettings /Gtk/CursorThemeName -t string -s "${CURSOR_THEME:-Vault.OS}"
  xq_set xsettings /Gtk/CursorThemeSize -t int -s "${CURSOR_SIZE:-24}"
  if [[ "${THEME_NAME}" == "Vault.OS-Reduced" || "${A11Y:-0}" == "1" || "${A11Y_MOTION:-on}" == "off" ]]; then
    xq_set xsettings /Gtk/EnableAnimations -t bool -s false
  else
    xq_set xsettings /Gtk/EnableAnimations -t bool -s true
  fi
  xq_set xfwm4 /general/click_to_focus -t bool -s true
  # Sound follows Vault.OS (or mute) — do not bind PipBoy-NV audio unless theme is PipBoy-NV
  if [[ -d "$HOME/.local/share/sounds/Vault.OS" ]]; then
    xq_set xsettings /Net/SoundThemeName -t string -s "Vault.OS"
    xq_set xsettings /Net/EnableEventSounds -t bool -s true
  elif [[ "${THEME_NAME:-Vault.OS}" == "PipBoy-NV" && -d "$HOME/.local/share/sounds/PipBoy-NV" ]]; then
    xq_set xsettings /Net/SoundThemeName -t string -s "PipBoy-NV"
    xq_set xsettings /Net/EnableEventSounds -t bool -s true
  else
    xq_set xsettings /Net/EnableEventSounds -t bool -s false
    if [[ "$(xq_get xsettings /Net/SoundThemeName | head -1)" == "PipBoy-NV" ]]; then
      xq_set xsettings /Net/SoundThemeName -t string -s "freedesktop"
    fi
  fi
  xq_set xsettings /Net/EnableInputFeedbackSounds -t bool -s false
  # Doors follow GTK theme name when Reduced/CANON
  if [[ "$THEME_NAME" == "Vault.OS-Reduced" ]]; then
    WM_THEME="Vault.OS-Reduced"
  elif [[ "$THEME_NAME" == "Vault.OS" ]]; then
    WM_THEME="Vault.OS"
  fi
  xq_set xfwm4 /general/theme -t string -s "$WM_THEME"
  xq_set xfwm4 /general/title_font -t string -s "$TITLE_FONT"
  xq_set xfwm4 /general/workspace_names -t string -s "STAT" -t string -s "DATA" -t string -s "ITEM" -t string -s "MAP"
  xq_set xfwm4 /general/workspace_count -t int -s 4

  # Wallpaper is user-owned. Do not write last-image here.

  # Desktop icon label colors (CRT green)
  xq_set xfce4-desktop /desktop-icons/label-text-color \
    -t double -s 0.72 -t double -s 1.0 -t double -s 0.80 -t double -s 1.0
  xq_set xfce4-desktop /desktop-icons/label-background-color \
    -t double -s 0.027 -t double -s 0.051 -t double -s 0.035 -t double -s 0.75
  xq_set xfce4-desktop /desktop-icons/use-custom-label-text-color -t bool -s true
  xq_set xfce4-desktop /desktop-icons/use-custom-label-background-color -t bool -s true

  # Notifications (avoid /primary-monitor — type varies by xfce4-notifyd version)
  # Drop legacy wrong-typed props if present
  if have xfconf-query; then
    for bad in /primary-monitor; do
      xfconf-query -c xfce4-notifyd -p "$bad" -r 2>/dev/null || true
    done
  fi
  # notify chrome: Reduced pack if present, else Vault.OS
  local notify_theme="Vault.OS"
  if [[ "${THEME_NAME:-Vault.OS}" == "Vault.OS-Reduced" && -d "$HOME/.themes/Vault.OS-Reduced/xfce-notify-4.0" ]]; then
    notify_theme="Vault.OS-Reduced"
  elif [[ "${THEME_NAME:-Vault.OS}" == "PipBoy-NV" ]]; then
    notify_theme="PipBoy-NV"
  fi
  xq_set xfce4-notifyd /theme -t string -s "$notify_theme"
  xq_set xfce4-notifyd /do-fadeout -t bool -s false
  xq_set xfce4-notifyd /do-slideout -t bool -s false
  xq_set xfce4-notifyd /initial-opacity -t double -s 1.0
  # Modern xfce4-notifyd uses string enum: top-left|bottom-left|top-right|bottom-right
  # Older builds used int — detect and set the correct type for this system.
  if have xfconf-query; then
    cur=$(xfconf-query -c xfce4-notifyd -p /notify-location 2>/dev/null || true)
    if [[ -z "$cur" ]]; then
      # Prefer string (current xfce4-notifyd); fall back to int
      xfconf-query -c xfce4-notifyd -p /notify-location -n -t string -s "bottom-left" 2>/dev/null \
        || xfconf-query -c xfce4-notifyd -p /notify-location -n -t int -s 1 2>/dev/null \
        || true
    elif [[ "$cur" =~ ^[0-9]+$ ]]; then
      : # numeric already — leave it
    else
      : # string already — leave it
    fi
  fi

  # Clock format only if plugin-8 is actually a clock (IDs drift)
  local p8
  p8=$(xq_get xfce4-panel /plugins/plugin-8 | head -1)
  if [[ "$p8" == *clock* ]]; then
    xq_set xfce4-panel /plugins/plugin-8/digital-time-format -t string -s "%I:%M %p  %a %d"
    xq_set xfce4-panel /plugins/plugin-8/digital-format -t string -s "%I:%M %p  %a %d"
  fi

  # GTK settings.ini
  local gtk_anim=true gtk_auto_mnemonics=true
  if [[ "${THEME_NAME}" == "Vault.OS-Reduced" || "${A11Y:-0}" == "1" || "${A11Y_MOTION:-on}" == "off" ]]; then
    gtk_anim=false
  fi
  if [[ "${THEME_NAME}" == "Vault.OS-Reduced" || "${A11Y:-0}" == "1" ]]; then
    gtk_auto_mnemonics=false
  fi
  mkdir -p "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"
  printf '%s\n' \
    '[Settings]' \
    "gtk-theme-name=${THEME_NAME}" \
    "gtk-icon-theme-name=${ICON_THEME}" \
    "gtk-font-name=${UI_FONT}" \
    "gtk-cursor-theme-name=${CURSOR_THEME:-Vault.OS}" \
    "gtk-cursor-theme-size=${CURSOR_SIZE:-24}" \
    'gtk-application-prefer-dark-theme=1' \
    'gtk-xft-antialias=1' \
    'gtk-xft-hinting=1' \
    'gtk-xft-hintstyle=hintslight' \
    'gtk-xft-rgba=rgb' \
    "gtk-enable-animations=${gtk_anim}" \
    'gtk-enable-accels=true' \
    'gtk-enable-mnemonics=true' \
    "gtk-auto-mnemonics=${gtk_auto_mnemonics}" \
    'gtk-overlay-scrolling=false' \
    > "$HOME/.config/gtk-3.0/settings.ini"
  cp -f "$HOME/.config/gtk-3.0/settings.ini" "$HOME/.config/gtk-4.0/settings.ini"



  # GTK user overlays — HUD import only; never legacy neon; spinner stays in theme
  local overlay_src; overlay_src="$(_gtk_overlay_dir)"
  local hud_theme="$THEME_NAME"
  case "$hud_theme" in
    Vault.OS|Vault.OS-Reduced) ;;
    *) hud_theme="Vault.OS" ;;
  esac
  mkdir -p "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"
  printf '%s
' \
    '/* Vault.OS user GTK overlay — import theme HUD only; never PipBoy CSS */' \
    '/* Spinner fix: theme gtk-3.0/gtk-3.20 only (no fighting user override). */' \
    "@import url(\"file://$HOME/.themes/${hud_theme}/gtk-3.0/hud.css\");" \
    > "$HOME/.config/gtk-3.0/gtk.css"
  if [[ -f "$overlay_src/gtk4.css" ]]; then
    cp -f "$overlay_src/gtk4.css" "$HOME/.config/gtk-4.0/gtk.css"
    if [[ "$THEME_NAME" == "Vault.OS-Reduced" && -f "$overlay_src/gtk4-a11y.css" ]]; then
      cat "$overlay_src/gtk4-a11y.css" >> "$HOME/.config/gtk-4.0/gtk.css"
    fi
  fi


  # Flatpak GTK/icon theme alignment
  if have flatpak; then
    flatpak override --user --env=GTK_THEME="$THEME_NAME" 2>/dev/null || true
    flatpak override --user --env=ICON_THEME="$ICON_THEME" 2>/dev/null || true
    flatpak override --user --filesystem=xdg-config/gtk-3.0:ro 2>/dev/null || true
    flatpak override --user --filesystem=xdg-config/gtk-4.0:ro 2>/dev/null || true
    flatpak override --user --filesystem=~/.themes:ro 2>/dev/null || true
    flatpak override --user --filesystem=~/.icons:ro 2>/dev/null || true
    flatpak override --user --filesystem=~/.local/share/icons:ro 2>/dev/null || true
  fi

  # Qt (qt5ct/qt6ct) — keep in sync
  for qt in qt5ct qt6ct; do
    local qtc="$HOME/.config/$qt/$qt.conf"
    mkdir -p "$HOME/.config/$qt"
    if [[ -f "$qtc" ]]; then
      sed -i "s|^icon_theme=.*|icon_theme=${ICON_THEME}|" "$qtc" 2>/dev/null || true
      sed -i "s|^style=.*|style=kvantum|" "$qtc" 2>/dev/null || true
    else
      printf '%s\n' \
        '[Appearance]' \
        'custom_palette=false' \
        "icon_theme=${ICON_THEME}" \
        'standard_dialogs=default' \
        'style=kvantum' \
        '' \
        '[Fonts]' \
        "fixed=\"${MONO_FONT%,*},10,-1,5,50,0,0,0,0,0\"" \
        "general=\"${UI_FONT%,*},10,-1,5,50,0,0,0,0,0\"" \
        > "$qtc"
    fi
  done

  write_vault_os_env

  # Terminal — vaultos-terminal-phosphor (CANON palette)
  # Modes: full|reduced|clear. Default reduced. See source/xfce4-terminal/A11Y.md
  if have vaultos-terminal-phosphor; then
    local phos_mode
    phos_mode="$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/Vault.OS/terminal-phosphor" 2>/dev/null || echo reduced)"
    case "$phos_mode" in full|reduced|clear) ;; *) phos_mode=reduced ;; esac
    vaultos-terminal-phosphor "$phos_mode" >/dev/null || true
    xq_set xfce4-terminal /title-initial -t string -s "ROBCO 76"
    xq_set xfce4-terminal /misc-borders-default -t bool -s true
    xq_set xfce4-terminal /scrolling-bar -t string -s "TERMINAL_SCROLLBAR_RIGHT"
  elif have xfconf-query; then
    # Fallback CANON if dial missing
    local pal="#070807;#C41E3A;#0E8A3A;#FFB000;#2A332A;#C41E3A;#1AFF6B;#8A8F86;#121612;#C41E3A;#1AFF6B;#FFB000;#8A8F86;#C41E3A;#1AFF6B;#C7C9C5"
    xq_set xfce4-terminal /color-use-theme -t bool -s false
    xq_set xfce4-terminal /color-foreground -t string -s "#1AFF6B"
    xq_set xfce4-terminal /color-background -t string -s "#070807"
    xq_set xfce4-terminal /color-cursor -t string -s "#1AFF6B"
    xq_set xfce4-terminal /color-bold -t string -s "#66FF9C"
    xq_set xfce4-terminal /color-palette -t string -s "$pal"
    xq_set xfce4-terminal /background-mode -t string -s "TERMINAL_BACKGROUND_SOLID"
    xq_set xfce4-terminal /misc-borders-default -t bool -s true
    xq_set xfce4-terminal /font-name -t string -s "Share Tech Mono 11"
    xq_set xfce4-terminal /title-initial -t string -s "ROBCO 76"
    xq_set xfce4-terminal /scrolling-bar -t string -s "TERMINAL_SCROLLBAR_RIGHT"
  fi

  ensure_xfdesktop || true
  log "apply complete"
}


cmd_ensure_panel() {
  log "ensure panels"

  # Always write FULL position strings — XFCE truncating to p=N loses the bottom bar
  xq_begin
  xq_set xfce4-panel /panels -t int -s 1 -t int -s 2

  xq_set xfce4-panel /panels/panel-1/position -t string -s "$PANEL1_POSITION"
  xq_set xfce4-panel /panels/panel-1/length -t double -s "$PANEL1_LENGTH"
  xq_set xfce4-panel /panels/panel-1/size -t int -s "$PANEL1_SIZE"
  xq_set xfce4-panel /panels/panel-1/autohide-behavior -t int -s "$PANEL1_AUTOHIDE"
  xq_set xfce4-panel /panels/panel-1/position-locked -t bool -s true
  xq_set xfce4-panel /panels/panel-1/mode -t int -s 0

  xq_set xfce4-panel /panels/panel-2/position -t string -s "$PANEL2_POSITION"
  xq_set xfce4-panel /panels/panel-2/length -t double -s "$PANEL2_LENGTH"
  xq_set xfce4-panel /panels/panel-2/size -t int -s "$PANEL2_SIZE"
  xq_set xfce4-panel /panels/panel-2/autohide-behavior -t int -s "$PANEL2_AUTOHIDE"
  xq_set xfce4-panel /panels/panel-2/position-locked -t bool -s true
  xq_set xfce4-panel /panels/panel-2/mode -t int -s 0

  # Panel chrome — prefer textured images (style 2), color fallback (style 1)
  local bg_style="${PANEL_BG_STYLE:-2}"
  xq_set xfce4-panel /panels/panel-1/background-style -t int -s "$bg_style"
  xq_set xfce4-panel /panels/panel-2/background-style -t int -s "$bg_style"
  if [[ -f "${PANEL1_BG_IMAGE:-}" ]]; then
    xq_set xfce4-panel /panels/panel-1/background-image -t string -s "$PANEL1_BG_IMAGE"
  fi
  if [[ -f "${PANEL2_BG_IMAGE:-}" ]]; then
    xq_set xfce4-panel /panels/panel-2/background-image -t string -s "$PANEL2_BG_IMAGE"
  fi
  xq_commit
  local p
  for p in 1 2; do
    if have xfconf-query; then
      if ! xfconf-query -c xfce4-panel -p "/panels/panel-${p}/background-rgba" >/dev/null 2>&1; then
        xfconf-query -c xfce4-panel -p "/panels/panel-${p}/background-rgba" -n \
          -t double -s "$PANEL_BG_R" \
          -t double -s "$PANEL_BG_G" \
          -t double -s "$PANEL_BG_B" \
          -t double -s "$PANEL_BG_A" 2>/dev/null || true
      fi
    fi
  done
  xq_set xfce4-panel /panels/panel-1/icon-size -t int -s "${PANEL1_ICON_SIZE:-16}"
  xq_set xfce4-panel /panels/panel-2/icon-size -t int -s "${PANEL2_ICON_SIZE:-32}" 

  local len2
  len2=$(xq_get xfce4-panel /panels/panel-2/length | head -1)
  if ! _panel_num_ok "${len2:-0}" 50; then
    warn "panel-2 length bad ($len2) — re-asserting via xfconf (not overwriting live XML)"
    xq_set xfce4-panel /panels/panel-2/length -t double -s "$PANEL2_LENGTH"
  fi

  if ! pgrep -x xfce4-panel >/dev/null 2>&1; then
    warn "xfce4-panel dead — starting"
    local good="${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv/xfce4-panel.xml.known-good"
    local live="$HOME/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml"
    if [[ -f "$good" ]]; then
      [[ -f "$live" ]] && cp -a "$live" "${live}.bak"
      cp -a "$good" "$live"
    fi
    nohup xfce4-panel >>"${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv/panel.log" 2>&1 &
    sleep 0.7
  fi

  # Re-assert full positions (daemon may rewrite to p=N only)
  xq_set xfce4-panel /panels/panel-1/position -t string -s "$PANEL1_POSITION"
  xq_set xfce4-panel /panels/panel-2/position -t string -s "$PANEL2_POSITION"

  # Keep Whisker sizing professional (no oversized menu)
  if xq_get xfce4-panel /plugins/plugin-1 2>/dev/null | grep -qx whiskermenu; then
    xq_set xfce4-panel /plugins/plugin-1/menu-width -t int -s 320
    xq_set xfce4-panel /plugins/plugin-1/menu-height -t int -s 420
    xq_set xfce4-panel /plugins/plugin-1/menu-opacity -t int -s 100
  fi

  # Session UI: top-right launcher → centered logout (never Actions appearance=1 dropdown)
  # Clipped at the right edge on 1920-wide panels; keep this pinned across ensure-theme.
  local p10
  p10="$(xq_get xfce4-panel /plugins/plugin-10 2>/dev/null | head -1)"
  if [[ "$p10" == "actions" || "$p10" == "launcher" || -z "$p10" ]] \
     || xq_get xfce4-panel /panels/panel-1/plugin-ids 2>/dev/null | grep -qx 10; then
    mkdir -p "$HOME/.config/xfce4/panel/launcher-10"
    # Drop Actions leftovers that make xfconf keep the edge dropdown
    if have xfconf-query; then
      xfconf-query -c xfce4-panel -p /plugins/plugin-10/appearance -r 2>/dev/null || true
      xfconf-query -c xfce4-panel -p /plugins/plugin-10/button-title -r 2>/dev/null || true
    fi
    printf '%s\n' \
      '[Desktop Entry]' \
      'Version=1.0' \
      'Type=Application' \
      'Name=Session' \
      'Comment=Centered lock / logout / power' \
      "Exec=$HOME/.local/bin/xfce4-session-logout" \
      'Icon=system-shutdown-symbolic' \
      'Terminal=false' \
      'StartupNotify=true' \
      > "$HOME/.config/xfce4/panel/launcher-10/session.desktop"
    xq_set xfce4-panel /plugins/plugin-10 -t string -s launcher
    xfconf-query -c xfce4-panel -p /plugins/plugin-10/items --force-array -t string -s session.desktop 2>/dev/null \
      || xfconf-query -c xfce4-panel -p /plugins/plugin-10/items -n -a -t string -s session.desktop 2>/dev/null \
      || true
  fi

  if pgrep -x xfce4-panel >/dev/null 2>&1; then
    log "panels OK (pid $(pgrep -x xfce4-panel | head -1))"
    return 0
  fi
  err "failed to start xfce4-panel"
  return 1
}

cmd_intro() {
  if [[ "${INTRO_ENABLED:-0}" != "1" ]] || [[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv/skip-boot-intro" ]]; then
    log "intro disabled"
    return 0
  fi
  local intro="$INTRO_FILE"
  [[ -f "$intro" ]] || intro="$HOME/.local/share/fallout-nv/FNVIntro-1080p-1m26s.mp4"
  if [[ ! -f "$intro" ]]; then warn "intro media missing"; return 0; fi
  have mpv || { warn "mpv missing"; return 0; }
  if intro_mpv_running; then log "intro already playing"; return 0; fi

  local lock="$LOCK_DIR/intro.lock"
  log "intro start: $intro"
  (
    flock -n 200 || exit 0
    local i
    for i in $(seq 1 60); do
      xset q &>/dev/null && break
      sleep 0.05
    done
    exec mpv \
      --fullscreen \
      --force-window=immediate \
      --no-border \
      --ontop \
      --cursor-autohide=always \
      --no-osc \
      --osd-level=0 \
      --really-quiet \
      --keep-open=no \
      --stop-screensaver \
      --hwdec=auto-safe \
      --vo=gpu \
      --profile=fast \
      --volume="${INTRO_VOLUME:-90}" \
      --title="Fallout: New Vegas — Opening" \
      "$intro"
  ) 200>"$lock" &
  disown 2>/dev/null || true
}

cmd_intro_enable() {
  rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv/skip-boot-intro"
  [[ -f "$CONF_DEFAULT" ]] && sed -i 's/^INTRO_ENABLED=.*/INTRO_ENABLED=1/' "$CONF_DEFAULT" 2>/dev/null || true
  log "intro enabled"
}
cmd_intro_disable() {
  mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv"
  touch "${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv/skip-boot-intro"
  [[ -f "$CONF_DEFAULT" ]] && sed -i 's/^INTRO_ENABLED=.*/INTRO_ENABLED=0/' "$CONF_DEFAULT" 2>/dev/null || true
  stop_intro_mpv
  log "intro disabled"
}


cmd_ensure_theme() {
  # Single lock path: conf THEME_NAME wins. Vault.OS-Reduced only if conf says so.
  load_config
  local want_t="${THEME_NAME:-Vault.OS}"
  local want_i="${ICON_THEME:-Vault.OS}"
  local want_w="${WM_THEME:-Vault.OS}"
  local want_c="${CURSOR_THEME:-Vault.OS}"
  case "$want_t" in Vault.OS|Vault.OS-Reduced) ;; *) want_t="Vault.OS" ;; esac
  # Reduced GTK must not keep CANON doors — follow THEME_NAME for xfwm
  if [[ "$want_t" == "Vault.OS-Reduced" ]]; then
    want_w="Vault.OS-Reduced"
  elif [[ "$want_t" == "Vault.OS" && "$want_w" == "Vault.OS-Reduced" ]]; then
    want_w="Vault.OS"
  fi
  local cur_t cur_i cur_w cur_c
  cur_t=$(xq_get xsettings /Net/ThemeName | head -1)
  cur_i=$(xq_get xsettings /Net/IconThemeName | head -1)
  cur_w=$(xq_get xfwm4 /general/theme | head -1)
  cur_c=$(xq_get xsettings /Gtk/CursorThemeName | head -1)

  local bad=0
  [[ "$cur_t" == "$want_t" ]] || bad=1
  [[ "$cur_i" == "$want_i" ]] || bad=1
  [[ "$cur_w" == "$want_w" ]] || bad=1
  [[ "$cur_c" == "$want_c" ]] || bad=1
  case "$cur_t" in Adwaita|Adwaita-dark|Greybird|Default|PipBoy-NV|"" ) bad=1 ;; esac
  case "$cur_w" in Adwaita|Greybird|Default|PipBoy-NV|"" ) bad=1 ;; esac
  case "$cur_i" in Adwaita|hicolor|FalloutMojave|PipBoy-NV|"" ) bad=1 ;; esac

  if [[ "$bad" -eq 1 ]]; then
    warn "theme drift (gtk='$cur_t' icons='$cur_i' wm='$cur_w') — reapplying $want_t"
    cmd_apply
    pgrep -x xfsettingsd >/dev/null 2>&1 && killall -HUP xfsettingsd 2>/dev/null || true
    if pgrep -x xfwm4 >/dev/null 2>&1; then
      cur_w=$(xq_get xfwm4 /general/theme | head -1)
      if [[ "$cur_w" != "$want_w" ]]; then
        xq_set xfwm4 /general/theme -t string -s "$want_w"
      fi
    fi
  else
    # Values already match. Do not write xfconf — xfwm/panel treat a
    # same-value set as a theme reload and eventually stop mapping windows.
    :
  fi

  # Pin notify + panel plates only when they drifted (xq_set is a no-op if equal).
  xq_begin
  xq_set xfce4-notifyd /theme -t string -s "Vault.OS"
  local top="${PANEL1_BG_IMAGE:-$HOME/.local/share/backgrounds/Vault.OS/panel-top.png}"
  local dock="${PANEL2_BG_IMAGE:-$HOME/.local/share/backgrounds/Vault.OS/panel-dock.png}"
  xq_set xfce4-panel /panels/panel-1/background-image -t string -s "$top"
  xq_set xfce4-panel /panels/panel-2/background-image -t string -s "$dock"
  xq_set xfce4-panel /panels/panel-1/background-style -t int -s "${PANEL_BG_STYLE:-2}"
  xq_set xfce4-panel /panels/panel-2/background-style -t int -s "${PANEL_BG_STYLE:-2}"
  xq_set xfce4-panel /panels/panel-1/size -t int -s "${PANEL1_SIZE:-28}"
  # xfce4-session LockScreen-before-shutdown hangs forever if the saver is wedged.
  xq_set xfce4-session /shutdown/LockScreen -t bool -s false
  # Must NOT be "xflock4": stock xflock4 calls Session.Lock which runs LockCommand.
  # Prefer vaultos-session-lock (spin then lock). Never xflock4.
  xq_set xfce4-session /general/LockCommand -t string -s "$HOME/.local/bin/vaultos-session-lock"
  # Let logind own the power button so a short press still works when GTK is dead.
  xq_set xfce4-power-manager /xfce4-power-manager/logind-handle-power-key -t bool -s true
  # 5-minute blank + 15-minute DPMS locked movies. 0 = never on AC.
  xq_set xfce4-power-manager /xfce4-power-manager/blank-on-ac -t int -s 0
  xq_set xfce4-power-manager /xfce4-power-manager/dpms-on-ac-sleep -t int -s 0
  xq_set xfce4-power-manager /xfce4-power-manager/dpms-on-ac-off -t int -s 0
  xq_commit
  if xq_get xfce4-panel /plugins/plugin-1 2>/dev/null | grep -qx whiskermenu; then
    local pwr="$HOME/.local/bin/vault-os-power"
    if [[ -x "$pwr" ]]; then
      xq_set xfce4-panel /plugins/plugin-1/command-logout -t string -s "$pwr logout"
      xq_set xfce4-panel /plugins/plugin-1/command-restart -t string -s "$pwr reboot"
      xq_set xfce4-panel /plugins/plugin-1/command-shutdown -t string -s "$pwr shutdown"
    fi
  fi
  # Custom ~/.local saver .desktops are NOT scanned by xfce4-screensaver.
  # System desktop vaultos-arch-spin.desktop exists but Hidden=true + missing
  # /usr/lib binary → (null) command. Until sudo fixes that, pin stock
  # slideshow to lock-slides spin frames (Y-axis foreshorten sequence).
  local saver_want="screensavers-vaultos-arch-spin"
  local saver_cur
  saver_cur=$(xq_get xfce4-screensaver /saver/themes/list | tail -1)
  if [[ "$saver_cur" != "$saver_want" ]]; then
    xfconf-query -c xfce4-screensaver -p /saver/themes/list --force-array -t string -s "$saver_want" 2>/dev/null \
      || xfconf-query -c xfce4-screensaver -p /saver/themes/list -n -a -t string -s "$saver_want" 2>/dev/null \
      || true
  fi
  xq_set xfce4-screensaver /screensavers/xfce-personal-slideshow/images-location -t string -s "$HOME/.local/share/backgrounds/Vault.OS/lock-spin-frames"
  xq_set xfce4-screensaver /screensavers/xfce-personal-slideshow/location -t string -s "$HOME/.local/share/backgrounds/Vault.OS/lock-spin-frames"
  xq_set xfce4-screensaver /lock/enabled -t bool -s true
  xq_set xfce4-screensaver /lock/saver-activation/enabled -t bool -s true
  if [[ "$bad" -eq 1 ]] && have vaultos-terminal-phosphor; then
    local phos_mode
    phos_mode="$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/Vault.OS/terminal-phosphor" 2>/dev/null || echo reduced)"
    case "$phos_mode" in full|reduced|clear) ;; *) phos_mode=reduced ;; esac
    vaultos-terminal-phosphor "$phos_mode" >/dev/null || true
  fi




  # GTK overlays always — HUD import only (spinner lives in theme gtk.css)
  overlay_src="$(_gtk_overlay_dir)"
  hud_theme="$want_t"
  case "$hud_theme" in Vault.OS|Vault.OS-Reduced) ;; *) hud_theme="Vault.OS" ;; esac
  mkdir -p "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"
  printf '%s
' \
    '/* Vault.OS user GTK overlay — import theme HUD only; never PipBoy CSS */' \
    '/* Spinner fix: theme gtk-3.0/gtk-3.20 only (no fighting user override). */' \
    "@import url(\"file://$HOME/.themes/${hud_theme}/gtk-3.0/hud.css\");" \
    > "$HOME/.config/gtk-3.0/gtk.css"
  if [[ -f "$overlay_src/gtk4.css" ]]; then
    cp -f "$overlay_src/gtk4.css" "$HOME/.config/gtk-4.0/gtk.css"
    if [[ "$THEME_NAME" == "Vault.OS-Reduced" && -f "$overlay_src/gtk4-a11y.css" ]]; then
      cat "$overlay_src/gtk4-a11y.css" >> "$HOME/.config/gtk-4.0/gtk.css"
    fi
  fi


  if [[ "$bad" -eq 1 && -x "$HOME/.local/bin/vault-os-chromium-theme" ]]; then
    "$HOME/.local/bin/vault-os-chromium-theme" 2>/dev/null || true
  fi
}


cmd_ensure_qt() {
  # Qt/Kvantum: use THEME_NAME if a Kvantum skin exists; else PipBoy-NV (only Qt skin shipped)
  local kv_theme="${THEME_NAME:-Vault.OS}"
  [[ "$kv_theme" == "Vault.OS-Reduced" ]] && kv_theme="Vault.OS"
  if [[ ! -d "$HOME/.config/Kvantum/$kv_theme" ]]; then
    kv_theme="PipBoy-NV"
  fi
  log "ensure Qt/Kvantum $kv_theme (GTK/xfwm stay ${THEME_NAME:-Vault.OS})"
  mkdir -p "$HOME/.config/Kvantum" "$HOME/.config/qt5ct" "$HOME/.config/qt6ct" "$HOME/.config/environment.d"
  if [[ -f "$HOME/.config/Kvantum/kvantum.kvconfig" ]]; then
    sed -i "s/^theme=.*/theme=${kv_theme}/" "$HOME/.config/Kvantum/kvantum.kvconfig" 2>/dev/null || true
  else
    printf '[General]\ntheme=%s\n' "$kv_theme" > "$HOME/.config/Kvantum/kvantum.kvconfig"
  fi
  for qt in qt5ct qt6ct; do
    local conf="$HOME/.config/$qt/$qt.conf"
    if [[ -f "$conf" ]]; then
      sed -i 's/^style=.*/style=kvantum/' "$conf" 2>/dev/null || true
      sed -i "s/^icon_theme=.*/icon_theme=${ICON_THEME}/" "$conf" 2>/dev/null || true
    fi
  done
  write_vault_os_env
}

cmd_ensure_coverage() {
  log "ensure extended theme coverage"
  cmd_ensure_qt || true
  # sounds — Vault.OS pack if present; else mute (never force PipBoy under Vault.OS)
  if [[ -d "$HOME/.local/share/sounds/Vault.OS" ]]; then
    xq_set xsettings /Net/SoundThemeName -t string -s "Vault.OS"
    xq_set xsettings /Net/EnableEventSounds -t bool -s true
  elif [[ "${THEME_NAME:-Vault.OS}" == "PipBoy-NV" && -d "$HOME/.local/share/sounds/PipBoy-NV" ]]; then
    xq_set xsettings /Net/SoundThemeName -t string -s "PipBoy-NV"
    xq_set xsettings /Net/EnableEventSounds -t bool -s true
  else
    xq_set xsettings /Net/EnableEventSounds -t bool -s false
    if [[ "$(xq_get xsettings /Net/SoundThemeName | head -1)" == "PipBoy-NV" ]]; then
      xq_set xsettings /Net/SoundThemeName -t string -s "freedesktop"
    fi
  fi
  # chromium theme
  if [[ -x "$HOME/.local/bin/vault-os-chromium-theme" ]]; then
    "$HOME/.local/bin/vault-os-chromium-theme" 2>/dev/null || true
  fi
  # flatpak
  if have flatpak; then
    flatpak override --user --env=GTK_THEME="$THEME_NAME" 2>/dev/null || true
    flatpak override --user --env=ICON_THEME="$ICON_THEME" 2>/dev/null || true
    flatpak override --user --env=XCURSOR_THEME="${CURSOR_THEME:-Vault.OS}" 2>/dev/null || true
  fi
}

cmd_coverage() {
  local kv qt vs ff disc snd
  kv=$(grep ^theme= "$HOME/.config/Kvantum/kvantum.kvconfig" 2>/dev/null | cut -d= -f2 || true)
  qt=$(grep ^style= "$HOME/.config/qt5ct/qt5ct.conf" 2>/dev/null | cut -d= -f2 || true)
  vs=$(grep colorTheme "$HOME/.config/Code - OSS/User/settings.json" 2>/dev/null | head -1 || true)
  ff=$(ls -d "$HOME/.mozilla/firefox/"*/chrome/userChrome.css 2>/dev/null | head -1 || true)
  disc=$(ls "$HOME/.config/Vencord/themes/PipBoyNV.theme.css" \
            "$HOME/.config/BetterDiscord/themes/PipBoyNV.theme.css" 2>/dev/null | head -1 || true)
  snd=$(ls -d "$HOME/.local/share/sounds/Vault.OS" 2>/dev/null || ls -d "$HOME/.local/share/sounds/PipBoy-NV" 2>/dev/null || true)
  printf 'Vault-OS theme coverage\n'
  printf '======================\n'
  printf 'GTK:     %s\n' "$(xq_get xsettings /Net/ThemeName | head -1)"
  printf 'Icons:   %s\n' "$(xq_get xsettings /Net/IconThemeName | head -1)"
  printf 'WM:      %s\n' "$(xq_get xfwm4 /general/theme | head -1)"
  printf 'Cursor:  %s\n' "$(xq_get xsettings /Gtk/CursorThemeName | head -1)"
  printf 'Sound:   %s\n' "$(xq_get xsettings /Net/SoundThemeName | head -1)"
  printf 'Notify:  %s\n' "$(xq_get xfce4-notifyd /theme | head -1)"
  printf 'Kvantum: %s\n' "${kv:-missing}"
  printf 'qt5ct:   %s\n' "${qt:-missing}"
  printf 'VS Code: %s\n' "${vs:-unset}"
  printf 'Firefox: %s\n' "${ff:-missing}"
  printf 'Discord: %s\n' "${disc:-missing}"
  local ldm
  ldm=$(grep -E '^theme-name=' /etc/lightdm/lightdm-gtk-greeter.conf 2>/dev/null | cut -d= -f2 || true)
  if [[ "$ldm" == "Vault.OS" || "$ldm" == "Vault.OS-Reduced" || "$ldm" == "PipBoy-NV" ]]; then
    printf 'LightDM: %s OK\n' "$ldm"
  else
    printf 'LightDM: missing (run vault-os-install-system-theme)\n'
  fi
  printf 'Sounds:  %s\n' "${snd:-missing}"
}

cmd_ensure_all() {
  # Single-process integrity pass for the watch timer (no panel restart).
  log "ensure-all"
  cmd_ensure_theme || true
  cmd_ensure_coverage || true
  ensure_xfdesktop || true
  cmd_ensure_panel || true
}

cmd_session_start() {
  local lock="$LOCK_DIR/session.lock"
  exec 8>"$lock"
  if ! flock -n 8; then warn "session-start already running"; return 0; fi

  log "session-start begin v$VERSION"
  local i
  for i in $(seq 1 100); do
    xset q &>/dev/null && break
    sleep 0.05
  done

  # Wait for xfsettingsd so our theme is not overwritten by late session defaults
  local j
  for j in $(seq 1 50); do
    pgrep -x xfsettingsd >/dev/null 2>&1 && break
    sleep 0.1
  done

  cmd_apply
  ensure_xfdesktop || true
  cmd_ensure_panel
  cmd_ensure_theme
  pgrep -x xfsettingsd >/dev/null 2>&1 && killall -HUP xfsettingsd 2>/dev/null || true

  # XFCE/settings often re-assert stock "GTK"/Adwaita shortly after login — fight the race
  ( sleep 2;  load_config; cmd_ensure_theme ) >/dev/null 2>&1 &
  ( sleep 6;  load_config; cmd_ensure_theme; cmd_ensure_panel ) >/dev/null 2>&1 &
  ( sleep 15; load_config; cmd_ensure_theme; cmd_ensure_coverage ) >/dev/null 2>&1 &

  cmd_intro

  local l2
  l2=$(xq_get xfce4-panel /panels/panel-2/length | head -1)
  if _panel_num_ok "${l2:-0}" 50; then
    local live="$HOME/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml"
    local good="${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv/xfce4-panel.xml.known-good"
    [[ -f "$live" ]] && cp -a "$live" "$good"
  fi
  log "session-start complete"
}

cmd_status() {
  local ec=0
  echo "vault-os $VERSION"
  echo "───────────────"
  local t i w
  t=$(xq_get xsettings /Net/ThemeName | head -1)
  i=$(xq_get xsettings /Net/IconThemeName | head -1)
  w=$(xq_get xfwm4 /general/theme | head -1)
  printf 'theme      %s %s\n' "$t" "$([[ "$t" == "$THEME_NAME" ]] && echo OK || echo DRIFT)"
  printf 'icons      %s %s\n' "$i" "$([[ "$i" == "$ICON_THEME" ]] && echo OK || echo DRIFT)"
  printf 'wm         %s %s\n' "$w" "$([[ "$w" == "$WM_THEME" ]] && echo OK || echo DRIFT)"
  if pgrep -x xfce4-panel >/dev/null 2>&1; then
    printf 'panel      running pid=%s\n' "$(pgrep -x xfce4-panel | head -1)"
  else
    printf 'panel      DEAD\n'; ec=1
  fi
  local p1 p2 pos2
  p1=$(xq_get xfce4-panel /panels/panel-1/length | head -1)
  p2=$(xq_get xfce4-panel /panels/panel-2/length | head -1)
  pos2=$(xq_get xfce4-panel /panels/panel-2/position | head -1)
  printf 'panel-1    length=%s\n' "$p1"
  printf 'panel-2    length=%s position=%s\n' "$p2" "$pos2"
  _panel_num_ok "${p2:-0}" 50 || { printf 'panel-2    LENGTH_BAD\n'; ec=1; }
  [[ "$pos2" == *x=* ]] || { printf 'panel-2    POSITION_INCOMPLETE\n'; ec=1; }
  if [[ "${INTRO_ENABLED:-0}" == "1" && ! -f "${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv/skip-boot-intro" ]]; then
    if [[ -f "$INTRO_FILE" || -f "$HOME/.local/share/fallout-nv/FNVIntro-1080p-1m26s.mp4" ]]; then
      printf 'intro      enabled (media OK)\n'
    else
      printf 'intro      enabled (media missing)\n'
    fi
  else
    printf 'intro      disabled\n'
  fi
  [[ -d "$HOME/.themes/$THEME_NAME" ]] && printf 'theme_dir  OK\n' || { printf 'theme_dir  MISSING\n'; ec=1; }
  if [[ -d "$HOME/.local/share/icons/$ICON_THEME" || -d "$HOME/.icons/$ICON_THEME" ]]; then
    printf 'icon_dir   OK\n'
  else
    printf 'icon_dir   MISSING\n'; ec=1
  fi
  local wall_live wall_ok=0
  wall_live=$(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep 'last-image$' | head -1 || true)
  if [[ -n "$wall_live" ]]; then
    wall_live=$(xq_get xfce4-desktop "$wall_live" | head -1)
    [[ -f "$wall_live" ]] && wall_ok=1
    printf 'wallpaper  %s %s\n' "$([[ $wall_ok -eq 1 ]] && echo OK || echo MISSING)" "${wall_live##*/}"
  else
    printf 'wallpaper  unset\n'
  fi
  local cur
  cur=$(xq_get xsettings /Gtk/CursorThemeName | head -1)
  if [[ "${cur:-}" == "${CURSOR_THEME}" ]]; then
    printf 'cursor     %s OK\n' "$cur"
  else
    printf 'cursor     %s DRIFT (want %s)\n' "${cur:-none}" "${CURSOR_THEME}"
  fi
  local ntheme
  ntheme=$(xq_get xfce4-notifyd /theme | head -1)
  printf 'notify     %s\n' "${ntheme:-default}"
  if has_share_tech_mono; then
    printf 'font       Share Tech Mono OK\n'
  else
    printf 'font       Share Tech Mono MISSING\n'
  fi
  if [[ -d "$HOME/.icons/${CURSOR_THEME:-Vault.OS}/cursors" || -d "$HOME/.local/share/icons/${CURSOR_THEME:-Vault.OS}/cursors" ]]; then
    printf 'cursor_dir OK\n'
  else
    printf 'cursor_dir MISSING\n'; ec=1
  fi
  if pgrep -x picom >/dev/null 2>&1; then
    printf 'picom      running\n'
  else
    printf 'picom      not running\n'
  fi
  if pgrep -x xfdesktop >/dev/null 2>&1; then
    printf 'xfdesktop  running\n'
  else
    printf 'xfdesktop  DEAD\n'; ec=1
  fi
  if [[ -d "$HOME/.themes/$THEME_NAME/xfce-notify-4.0" ]]; then
    printf 'notify_thm OK\n'
  else
    printf 'notify_thm MISSING\n'
  fi
  local ldm_theme
  ldm_theme=$(grep -E '^theme-name=' /etc/lightdm/lightdm-gtk-greeter.conf 2>/dev/null | cut -d= -f2 || true)
  if [[ "$ldm_theme" == "Vault.OS" || "$ldm_theme" == "Vault.OS-Reduced" ]]; then
    printf 'greeter    %s conf\n' "$ldm_theme"
  else
    printf 'greeter    conf missing\n'
  fi
  if [[ -d /usr/share/themes/Vault.OS/gtk-3.0 && -f /usr/share/backgrounds/Vault.OS/vault-111.png ]]; then
    printf 'greeter_sys OK\n'
  else
    printf 'greeter_sys MISSING (pkexec install)\n'
  fi
  return "$ec"
}


# ── Design bar / pitfall checks (doctor + lint) ────────────────────────────
# Rules come from DESIGN.md "Code quality bar" and ERRORS.md. Repo checks are
# read-only and need no X session, so `vault-os lint [PATH]` can run in CI.
# Patterns are split so this file never matches its own checks.
_CHK_FAIL=0
_CHK_WARN=0
_BANNED_HEX_RE='(#|0x)(33FF6A|44FF3D)|rgba?\(\s*(51\s*,\s*255\s*,\s*106|68\s*,\s*255\s*,\s*61)\b'
_SB_NONE_RE='ScrollingBar''=NONE|TERMINAL_SCROLLBAR_''NONE'
_IMPORTANT_RE='!\s*import''ant'
_CSS_JUNK_RE='text-trans''form|:(before|after)\b|-GtkNote''book-'

_chk() {
  # _chk OK|WARN|FAIL|SKIP label detail...
  local v="$1" label="$2"; shift 2
  case "$v" in
    FAIL) _CHK_FAIL=$((_CHK_FAIL + 1)) ;;
    WARN) _CHK_WARN=$((_CHK_WARN + 1)) ;;
  esac
  printf '%-14s %-4s %s\n' "$label" "$v" "$*"
}

_chk_list() {
  # Indent evidence lines from stdin; cap at $1 (default 8).
  local max="${1:-8}" n=0 line
  while IFS= read -r line; do
    n=$((n + 1))
    if (( n <= max )); then printf '                    %s\n' "$line"; fi
  done
  if (( n > max )); then printf '                    … +%d more\n' "$((n - max))"; fi
  return 0
}

_repo_root() {
  # The checkout this script lives in wins, so a worktree lints itself.
  local cand self
  self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
  for cand in "$(cd "$(dirname "$self")/.." 2>/dev/null && pwd)" "${VAULT_OS_ROOT:-}" \
              "$HOME/Projects/vault-os" "$HOME/Vault.OS"; do
    [[ -n "$cand" && -d "$cand/themes/Vault.OS" && -d "$cand/source" ]] && { printf '%s\n' "$cand"; return 0; }
  done
  return 1
}

# perl: print "relpath:line: text" for lines matching RE (case-insensitive).
# CSS block comments are blanked first (newlines kept) so a comment that
# states a rule does not trip it.
# shellcheck disable=SC2016  # perl source, not shell
_SCAN_PL='
my ($re, $root) = (shift, shift);
for my $f (@ARGV) {
  open(my $fh, "<", $f) or next; local $/; my $t = <$fh>; close $fh;
  next unless defined $t;
  if ($f =~ /\.css$/) { $t =~ s{/\*.*?\*/}{ my $c = $&; $c =~ s/[^\n]//g; $c }gse; }
  my $n = 0;
  for my $l (split /\n/, $t, -1) {
    $n++;
    next unless $l =~ /$re/i;
    (my $r = $f) =~ s{^\Q$root\E/}{};
    (my $s = $l) =~ s/^\s+//;
    print "$r:$n: " . substr($s, 0, 110) . "\n";
  }
}'

_scan() {
  # _scan ROOT REGEX GLOB path...   (GLOB: "*" or e.g. "*.css")
  local root="$1" re="$2" glob="$3"; shift 3
  local p files=()
  for p in "$@"; do
    [[ -e "$p" ]] || continue
    while IFS= read -r -d '' f; do files+=("$f"); done < <(
      find "$p" \( -name __pycache__ -o -name .git \) -prune -o -type f -name "$glob" \
        ! -name '*.md' ! -name '*.bak' ! -name '*.bak-*' ! -name '*~' -print0 2>/dev/null)
  done
  ((${#files[@]})) || return 0
  # Skip binaries (png etc.): grep -I lists text files that can match at all.
  local text=()
  while IFS= read -r f; do text+=("$f"); done < <(grep -IliE -- "${re//\\s/[[:space:]]}" "${files[@]}" 2>/dev/null || true)
  ((${#text[@]})) || return 0
  perl -e "$_SCAN_PL" "$re" "$root" "${text[@]}"
}

_dir_diff() {
  # _dir_diff A B [extra diff -x patterns...] -> differing/missing entries
  # (ignores docs, generators, caches)
  local a="$1" b="$2" x ex=(); shift 2
  for x in README.md '*.py' __pycache__ '*.bak' '*.bak-*' "$@"; do ex+=(-x "$x"); done
  diff -rq "${ex[@]}" "$a" "$b" 2>/dev/null | sed -e "s|$a/||g" -e "s|$b/||g" || true
}

_xpm_class() {
  # hexsym: every color has "c #hex s name"; symonly: "s name" only; mixed: other
  awk '
    /^"/ {
      if (!hdr) { split(substr($0, 2), a, " "); n = a[3] + 0; hdr = 1; next }
      if (n > 0) {
        n--
        if ($0 ~ / c [Nn]one/) next
        tot++
        hx = ($0 ~ / c #[0-9A-Fa-f]+/); sy = ($0 ~ / s [A-Za-z_0-9]+/)
        if (hx && sy) both++; else if (sy && !hx) so++
      }
    }
    END {
      if (tot == 0) print "none"
      else if (both == tot) print "hexsym"
      else if (so == tot) print "symonly"
      else print "mixed"
    }' "$1"
}

_lint_repo() {
  local R="$1"
  local hits

  # 1. One palette (DESIGN bar #1)
  local ship=() legacy=() p
  for p in themes/Vault.OS themes/Vault.OS-Reduced source bin icons/Vault.OS overlay \
           iso/airootfs tokens.css tokens-reduced.css install.sh \
           config/gtk-3.0 config/gtk-4.0 config/gtkrc-2.0 config/xfce4 config/fallout-nv \
           config/environment.d extras/panel extras/lightdm extras/dock; do
    [[ -e "$R/$p" ]] && ship+=("$R/$p")
  done
  for p in themes/PipBoy-NV icons/PipBoy-Dock config/pipboy config/Kvantum/PipBoy-NV \
           config/vscode config/discord config/firefox config/chromium; do
    [[ -e "$R/$p" ]] && legacy+=("$R/$p")
  done
  hits="$(_scan "$R" "$_BANNED_HEX_RE" '*' "${ship[@]}")"
  if [[ -z "$hits" ]]; then
    _chk OK palette "no banned phosphor hexes (33FF6A/44FF3D) in Vault.OS trees"
  else
    _chk FAIL palette "banned phosphor hex in shipped Vault.OS files (canon 1AFF6B, Reduced 66FF9C):"
    printf '%s\n' "$hits" | _chk_list 12
  fi
  if ((${#legacy[@]})); then
    hits="$(_scan "$R" "$_BANNED_HEX_RE" '*' "${legacy[@]}" | cut -d: -f1 | sort -u)"
    if [[ -n "$hits" ]]; then
      _chk WARN palette-old "legacy PipBoy-NV app themes still carry banned hexes ($(printf '%s\n' "$hits" | wc -l) files)"
      printf '%s\n' "$hits" | _chk_list 8
    else
      _chk OK palette-old "legacy PipBoy-NV app themes free of banned phosphor colours"
    fi
  fi

  # 2/3. CssProvider clean (DESIGN bar #5, ERRORS GTK rules)
  local gtkcss=()
  for p in themes/Vault.OS themes/Vault.OS-Reduced source/gtk-2.0 source/gtk-3.0 source/gtk-3.20 \
           source/gtk-reduced/gtk-3.0 source/gtk-reduced/gtk-3.20 source/gtk-overlay source/lock \
           source/lightdm source/xfce4-notifyd source/xfce4-panel source/xfce4-terminal \
           config/gtk-3.0 config/gtk-4.0; do
    [[ -e "$R/$p" ]] && gtkcss+=("$R/$p")
  done
  hits="$(_scan "$R" "$_IMPORTANT_RE" '*.css' "${gtkcss[@]}")"
  if [[ -z "$hits" ]]; then
    _chk OK gtk-important "no !-important in GTK css"
  else
    _chk FAIL gtk-important "GTK CssProvider treats !-important as junk:"
    printf '%s\n' "$hits" | _chk_list 12
  fi
  hits="$(_scan "$R" "$_CSS_JUNK_RE" '*.css' "${gtkcss[@]}")"
  if [[ -z "$hits" ]]; then
    _chk OK gtk-webcss "no text-transform / :before / :after / -GtkNotebook-* in GTK css"
  else
    _chk FAIL gtk-webcss "web-only CSS in GTK themes (CssProvider parse errors):"
    printf '%s\n' "$hits" | _chk_list 12
  fi

  # 4. gtk-3.0 + gtk-3.20 both ship (GTK 3.24 loads 3.20 first)
  local pair miss=()
  for pair in themes/Vault.OS themes/Vault.OS-Reduced source source/gtk-reduced; do
    [[ -d "$R/$pair" ]] || continue
    [[ -f "$R/$pair/gtk-3.0/gtk.css" ]]  || miss+=("$pair/gtk-3.0/gtk.css")
    [[ -f "$R/$pair/gtk-3.20/gtk.css" ]] || miss+=("$pair/gtk-3.20/gtk.css")
  done
  if ((${#miss[@]})); then
    _chk FAIL gtk-dirs "missing: ${miss[*]}"
  else
    _chk OK gtk-dirs "gtk-3.0 + gtk-3.20 in both packs (themes + source)"
  fi

  # 5. GTK source ≡ themes (DESIGN bar #2) — shared files only
  local src dst f d out=""
  for pair in "source/gtk-3.0:themes/Vault.OS/gtk-3.0" "source/gtk-3.20:themes/Vault.OS/gtk-3.20" \
              "source/gtk-reduced/gtk-3.0:themes/Vault.OS-Reduced/gtk-3.0" \
              "source/gtk-reduced/gtk-3.20:themes/Vault.OS-Reduced/gtk-3.20"; do
    src="$R/${pair%%:*}"; dst="$R/${pair##*:}"
    [[ -d "$src" && -d "$dst" ]] || continue
    for f in "$src"/*.css; do
      [[ -f "$f" ]] || continue
      d="$dst/${f##*/}"
      [[ -f "$d" ]] || continue
      cmp -s "$f" "$d" || out+="${pair%%:*}/${f##*/} ≠ ${pair##*:}/${f##*/}"$'\n'
    done
  done
  if [[ -z "$out" ]]; then
    _chk OK gtk-sync "source/ ≡ themes/ for shared GTK css"
  else
    _chk WARN gtk-sync "source/ and themes/ GTK css drifted (GTK-02 / HUD-04):"
    printf '%s' "$out" | _chk_list 12
  fi

  # 6/7. xfwm doors: source ≡ themes, and no mixed decoration trees
  local label
  for pair in "source/xfwm4:themes/Vault.OS/xfwm4:CANON" "source/xfwm4-reduced:themes/Vault.OS-Reduced/xfwm4:Reduced"; do
    IFS=: read -r src dst label <<<"$pair"
    if [[ ! -d "$R/$src" || ! -d "$R/$dst" ]]; then
      _chk SKIP "xfwm-$label" "$src or $dst not in repo"
      continue
    fi
    out="$(_dir_diff "$R/$src" "$R/$dst")"
    if [[ -z "$out" ]]; then
      _chk OK "xfwm-$label" "$src ≡ $dst"
    else
      _chk FAIL "xfwm-$label" "$src and $dst differ (replace the whole dir):"
      printf '%s\n' "$out" | _chk_list 10
    fi
    [[ -f "$R/$dst/themerc" ]] || _chk FAIL "xfwm-$label" "$dst/themerc missing"
    local x cls classes="" odd=()
    declare -A _xpm_n=()
    for x in "$R/$dst"/*.xpm; do
      [[ -f "$x" ]] || continue
      cls="$(_xpm_class "$x")"
      _xpm_n[$cls]=$(( ${_xpm_n[$cls]:-0} + 1 ))
      [[ "$cls" == hexsym ]] || odd+=("${x##*/}($cls)")
    done
    for cls in "${!_xpm_n[@]}"; do classes+="$cls=${_xpm_n[$cls]} "; done
    if (( ${#_xpm_n[@]} > 1 )) || [[ -n "${_xpm_n[mixed]:-}" ]]; then
      _chk FAIL "xfwm-$label" "mixed XPM tree (${classes% }): replace the whole dir"
      printf '%s\n' "${odd[@]}" | _chk_list 8
    elif (( ${#_xpm_n[@]} == 1 )); then
      _chk OK "xfwm-$label" "XPMs one color style (${classes% })"
    fi
    unset _xpm_n
  done

  # 8. Terminal scrollbar stays (ERRORS: terminal scrollbar hide)
  local tfiles=() bad="" missing=""
  for f in "$R"/source/xfce4-terminal/terminalrc* "$R"/config/xfce4/terminal/terminalrc*; do
    [[ -f "$f" ]] && tfiles+=("$f")
  done
  if ((${#tfiles[@]} == 0)); then
    _chk SKIP terminal "no terminalrc* in repo"
  else
    bad="$(_scan "$R" "$_SB_NONE_RE" '*' "${tfiles[@]}" "$R/bin/vaultos-terminal-phosphor" "$R/bin/vault-os")"
    for f in "${tfiles[@]}"; do
      grep -qx 'ScrollingBar=TERMINAL_SCROLLBAR_RIGHT' "$f" || missing+="${f#"$R"/} "
    done
    if [[ -n "$bad" ]]; then
      _chk FAIL terminal "scrollbar forced off:"
      printf '%s\n' "$bad" | _chk_list 8
    fi
    if [[ -n "$missing" ]]; then
      _chk FAIL terminal "no ScrollingBar=TERMINAL_SCROLLBAR_RIGHT in: $missing"
    fi
    if [[ -f "$R/bin/vaultos-terminal-phosphor" ]] && ! grep -q 'TERMINAL_SCROLLBAR_RIGHT' "$R/bin/vaultos-terminal-phosphor"; then
      _chk WARN terminal "vaultos-terminal-phosphor does not pin TERMINAL_SCROLLBAR_RIGHT"
    fi
    [[ -z "$bad$missing" ]] && _chk OK terminal "${#tfiles[@]} terminalrc* keep TERMINAL_SCROLLBAR_RIGHT; none forced off"
  fi

  # 9. Screensaver (ERRORS standing order: screensavers-vaultos-arch-spin)
  local sd="$R/source/xfce4-screensaver/vaultos-arch-spin.desktop" wrap=/usr/lib/xfce4-screensaver/vaultos-arch-spin
  if [[ -f "$sd" ]]; then
    out=""
    grep -q '^Hidden=' "$sd" && out+="Hidden= present; "
    grep -qx "Exec=$wrap" "$sd" || out+="Exec≠$wrap; "
    grep -qx "TryExec=$wrap" "$sd" || out+="TryExec≠$wrap; "
    if [[ -z "$out" ]]; then
      _chk OK saver-src "vaultos-arch-spin.desktop: no Hidden=, Exec/TryExec → $wrap"
    else
      _chk FAIL saver-src "source/xfce4-screensaver/vaultos-arch-spin.desktop: $out"
    fi
  else
    _chk SKIP saver-src "source/xfce4-screensaver/vaultos-arch-spin.desktop not in repo"
  fi
  if grep -q 'saver_want="screensavers-vaultos-arch-spin"' "$R/bin/vault-os" 2>/dev/null; then
    _chk OK saver-id "ensure-theme pins screensavers-vaultos-arch-spin"
  else
    _chk FAIL saver-id "bin/vault-os ensure-theme does not pin screensavers-vaultos-arch-spin"
  fi
  out="$(find "$R" -path "$R/.git" -prune -o -name 'xfce-floaters.desktop*' -type f \
         -exec grep -l '^Exec=.*vaultos' {} + 2>/dev/null | sed "s|^$R/||" || true)"
  if [[ -n "$out" ]]; then
    _chk FAIL saver-floaters "repo ships a hijacked xfce-floaters.desktop:"
    printf '%s\n' "$out" | _chk_list 4
  else
    _chk OK saver-floaters "no xfce-floaters.desktop hijack shipped"
  fi

  # 10. Desktop spin: static default, full only via desktop-spin=full
  local auto="$R/bin/vaultos-spin-arch-autostart"
  if [[ -f "$auto" ]]; then
    local tmp got_def got_full got_junk
    tmp="$(mktemp -d "${TMPDIR:-/tmp}/vault-os-lint.XXXXXX")"
    mkdir -p "$tmp/.local/bin" "$tmp/.config/Vault.OS"
    printf '#!/bin/sh\necho "$*"\n' >"$tmp/.local/bin/vaultos-spin-arch"
    chmod +x "$tmp/.local/bin/vaultos-spin-arch"
    _spin_run() { env -i HOME="$tmp" XDG_CONFIG_HOME="$tmp/.config" PATH=/usr/bin:/bin \
                    bash "$auto" 2>/dev/null </dev/null || true; }
    got_def="$(_spin_run)"
    echo full >"$tmp/.config/Vault.OS/desktop-spin"; got_full="$(_spin_run)"
    echo bogus >"$tmp/.config/Vault.OS/desktop-spin"; got_junk="$(_spin_run)"
    rm -rf "$tmp"
    unset -f _spin_run
    if [[ -z "$got_def$got_full" ]]; then
      _chk WARN spin-default "could not exercise vaultos-spin-arch-autostart (no vaultos-spin-arch call)"
    elif [[ "$got_def" == *--full* || "$got_junk" == *--full* ]]; then
      _chk FAIL spin-default "autostart spins without desktop-spin=full (default='$got_def' junk='$got_junk')"
    elif [[ "$got_full" != *--full* ]]; then
      _chk WARN spin-default "desktop-spin=full does not pass --full (got '$got_full')"
    else
      _chk OK spin-default "static by default ('$got_def'); --full only with desktop-spin=full"
    fi
  else
    _chk SKIP spin-default "bin/vaultos-spin-arch-autostart not in repo"
  fi
  out="$(grep -rlE --exclude-dir=.git --include='*.desktop' '^Exec=.*vaultos-spin-arch( |$).*--full' "$R" 2>/dev/null | sed "s|^$R/||" || true)"
  if [[ -n "$out" ]]; then
    _chk FAIL spin-autostart "hard --full Exec (use vaultos-spin-arch-autostart):"
    printf '%s\n' "$out" | _chk_list 4
  else
    _chk OK spin-autostart "no shipped .desktop hard-codes vaultos-spin-arch --full"
  fi

  # 11. Repo hygiene: doc + token copies in source/
  if [[ -f "$R/ERRORS.md" && -f "$R/source/ERRORS.md" ]]; then
    if cmp -s "$R/ERRORS.md" "$R/source/ERRORS.md"; then
      _chk OK errors-sync "ERRORS.md ≡ source/ERRORS.md"
    else
      _chk FAIL errors-sync "ERRORS.md and source/ERRORS.md differ (keep in sync)"
    fi
  else
    _chk SKIP errors-sync "ERRORS.md or source/ERRORS.md missing"
  fi
  for f in DESIGN.md:design-sync tokens.css:tokens-sync tokens-reduced.css:tokensR-sync; do
    label="${f##*:}"; f="${f%%:*}"
    [[ -f "$R/$f" && -f "$R/source/$f" ]] || continue
    if cmp -s "$R/$f" "$R/source/$f"; then
      _chk OK "$label" "$f ≡ source/$f"
    else
      _chk WARN "$label" "$f and source/$f differ"
    fi
  done

  # 12. Shell syntax on shipped helpers
  out=""
  for f in "$R"/bin/* "$R"/install.sh "$R"/source/xfce4-screensaver/install-system.sh; do
    [[ -f "$f" ]] || continue
    head -n1 "$f" | grep -qE '^#!.*\b(bash|sh)\b' || continue
    bash -n "$f" 2>/dev/null || out+="${f#"$R"/} "
  done
  if [[ -z "$out" ]]; then
    _chk OK shell-syntax "bash -n clean on bin/ + installers"
  else
    _chk FAIL shell-syntax "bash -n fails: $out"
  fi
  return 0
}

# shellcheck disable=SC2088  # "~/..." strings are display text
_doctor_live() {
  local R="$1" out f

  # Installed CLI should be this checkout (ERRORS: don't leave ~/.local/bin behind)
  local inst="$HOME/.local/bin/vault-os" iv
  if [[ -e "$inst" ]]; then
    if [[ -n "$R" && "$(readlink -f "$inst")" == "$(readlink -f "$R/bin/vault-os")" ]]; then
      _chk OK cli "~/.local/bin/vault-os → this checkout"
    else
      iv="$(grep -m1 '^readonly VERSION=' "$inst" 2>/dev/null | cut -d'"' -f2 || true)"
      if [[ "$iv" == "$VERSION" ]]; then
        _chk OK cli "~/.local/bin/vault-os $iv → $(readlink -f "$inst")"
      else
        _chk WARN cli "~/.local/bin/vault-os ${iv:-?} ≠ this $VERSION ($(readlink -f "$inst"))"
      fi
    fi
  else
    _chk WARN cli "~/.local/bin/vault-os missing (vault-os install)"
  fi

  # Live GTK packs
  local livep=() t
  for t in Vault.OS Vault.OS-Reduced; do
    [[ -d "$HOME/.themes/$t" ]] && livep+=("$HOME/.themes/$t")
  done
  [[ -f "$HOME/.config/gtk-3.0/gtk.css" ]] && livep+=("$HOME/.config/gtk-3.0/gtk.css")
  [[ -f "$HOME/.config/gtk-4.0/gtk.css" ]] && livep+=("$HOME/.config/gtk-4.0/gtk.css")
  out="$(_scan "$HOME" "$_BANNED_HEX_RE" '*' "${livep[@]}"; _scan "$HOME" "$_IMPORTANT_RE" '*.css' "${livep[@]}")"
  if [[ -z "$out" ]]; then
    _chk OK live-gtk "no banned hexes / !-important in ~/.themes Vault.OS* + GTK overlays"
  else
    _chk FAIL live-gtk "live theme/overlay breaks the palette or CssProvider rules:"
    printf '%s\n' "$out" | _chk_list 10
  fi
  out=""
  for t in Vault.OS Vault.OS-Reduced; do
    [[ -d "$HOME/.themes/$t" ]] || { out+="$t(not installed) "; continue; }
    [[ -f "$HOME/.themes/$t/gtk-3.0/gtk.css" ]]  || out+="$t/gtk-3.0 "
    [[ -f "$HOME/.themes/$t/gtk-3.20/gtk.css" ]] || out+="$t/gtk-3.20 "
  done
  if [[ -z "$out" ]]; then
    _chk OK live-gtk-dirs "~/.themes packs ship gtk-3.0 + gtk-3.20"
  else
    _chk FAIL live-gtk-dirs "missing: $out"
  fi
  if [[ -f "$HOME/.config/gtk-3.0/gtk.css" ]]; then
    if grep -v '^[[:space:]]*/\*' "$HOME/.config/gtk-3.0/gtk.css" | grep -qi 'spinner'; then
      _chk WARN gtk-overlay "~/.config/gtk-3.0/gtk.css carries a spinner override (HUD @import only)"
    else
      _chk OK gtk-overlay "~/.config/gtk-3.0/gtk.css is HUD import only"
    fi
  fi

  # Live packs vs this checkout (install drift — fix with: vault-os install)
  if [[ -n "$R" ]]; then
    local pair src dst label
    for pair in "themes/Vault.OS/xfwm4:Vault.OS/xfwm4:xfwm" "themes/Vault.OS-Reduced/xfwm4:Vault.OS-Reduced/xfwm4:xfwm-R" \
                "themes/Vault.OS/gtk-3.0:Vault.OS/gtk-3.0:gtk3" "themes/Vault.OS/gtk-3.20:Vault.OS/gtk-3.20:gtk320" \
                "themes/Vault.OS-Reduced/gtk-3.0:Vault.OS-Reduced/gtk-3.0:gtk3-R" \
                "themes/Vault.OS-Reduced/gtk-3.20:Vault.OS-Reduced/gtk-3.20:gtk320-R"; do
      IFS=: read -r src dst label <<<"$pair"
      [[ -d "$R/$src" && -d "$HOME/.themes/$dst" ]] || continue
      # terminal.css is rewritten at runtime by vaultos-terminal-phosphor (checked below)
      out="$(_dir_diff "$R/$src" "$HOME/.themes/$dst" terminal.css)"
      if [[ -z "$out" ]]; then
        _chk OK "live-$label" "~/.themes/$dst ≡ repo"
      else
        _chk WARN "live-$label" "~/.themes/$dst differs from repo $src (vault-os install to sync):"
        printf '%s\n' "$out" | _chk_list 6
      fi
    done
  fi

  # Terminal CRT dial owns ~/.themes/Vault.OS/gtk-*/terminal.css
  local pm tsrc
  pm="$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/Vault.OS/terminal-phosphor" 2>/dev/null || echo reduced)"
  case "$pm" in full|reduced|clear) ;; *) pm=reduced ;; esac
  tsrc="${R:+$R/source/xfce4-terminal/terminal.$pm.css}"
  if [[ -n "$tsrc" && -f "$tsrc" ]]; then
    out=""
    for t in gtk-3.0 gtk-3.20; do
      f="$HOME/.themes/Vault.OS/$t/terminal.css"
      [[ -f "$f" ]] || continue
      cmp -s "$f" "$tsrc" || out+="$t "
    done
    if [[ -z "$out" ]]; then
      _chk OK live-term-css "~/.themes/Vault.OS terminal.css = phosphor dial '$pm'"
    else
      _chk WARN live-term-css "terminal.css in $out≠ source terminal.$pm.css (vaultos-terminal-phosphor $pm)"
    fi
  fi

  # Terminal scrollbar (live)
  local trc="$HOME/.config/xfce4/terminal/terminalrc" sb
  if [[ -f "$trc" ]] && grep -qE "$_SB_NONE_RE" "$trc"; then
    _chk FAIL live-term "terminalrc forces the scrollbar off"
  fi
  sb="$(xq_get xfce4-terminal /scrolling-bar | head -1)"
  case "$sb" in
    TERMINAL_SCROLLBAR_RIGHT) _chk OK live-term "xfce4-terminal /scrolling-bar = RIGHT" ;;
    "") if [[ -f "$trc" ]] && grep -qx 'ScrollingBar=TERMINAL_SCROLLBAR_RIGHT' "$trc"; then
          _chk OK live-term "terminalrc ScrollingBar=TERMINAL_SCROLLBAR_RIGHT (xfconf unset)"
        else
          _chk WARN live-term "scrollbar not pinned to RIGHT (xfconf unset)"
        fi ;;
    *) _chk FAIL live-term "xfce4-terminal /scrolling-bar = $sb (want TERMINAL_SCROLLBAR_RIGHT)" ;;
  esac

  # Screensaver (standing order). System-file fixes need sudo:
  # source/xfce4-screensaver/install-system.sh
  local saver sysd=/usr/share/applications/screensavers/vaultos-arch-spin.desktop
  local wrap=/usr/lib/xfce4-screensaver/vaultos-arch-spin
  saver="$(xq_get xfce4-screensaver /saver/themes/list | tail -1)"
  if [[ "$saver" == "screensavers-vaultos-arch-spin" ]]; then
    _chk OK live-saver "theme = screensavers-vaultos-arch-spin"
  else
    _chk FAIL live-saver "theme = '${saver:-unset}' (want screensavers-vaultos-arch-spin)"
  fi
  if [[ -f "$sysd" ]]; then
    out=""
    grep -q '^Hidden=' "$sysd" && out+="Hidden= present; "
    grep -qx "Exec=$wrap" "$sysd" || out+="Exec≠$wrap; "
    grep -qx "TryExec=$wrap" "$sysd" || out+="TryExec≠$wrap; "
    if [[ -z "$out" ]]; then
      _chk OK live-saver "system desktop: no Hidden=, Exec/TryExec → $wrap"
    else
      _chk FAIL live-saver "$sysd: $out(sudo: install-system.sh)"
    fi
  else
    _chk FAIL live-saver "$sysd missing (sudo: source/xfce4-screensaver/install-system.sh)"
  fi
  if [[ -x "$wrap" ]]; then
    if [[ -n "$R" && -f "$R/source/xfce4-screensaver/vaultos-arch-spin.wrapper" ]] \
       && ! cmp -s "$wrap" "$R/source/xfce4-screensaver/vaultos-arch-spin.wrapper"; then
      _chk WARN live-saver "$wrap differs from source wrapper (sudo re-run install-system.sh to refresh)"
    else
      _chk OK live-saver "$wrap present"
    fi
  else
    _chk FAIL live-saver "$wrap missing or not executable (sudo: install-system.sh)"
  fi
  local fl=/usr/share/applications/screensavers/xfce-floaters.desktop
  if [[ -f "$fl" ]] && grep -qE '^(Try)?Exec=.*vaultos' "$fl"; then
    _chk FAIL live-saver "stock xfce-floaters.desktop is hijacked (restore .vaultos-stock; needs sudo)"
  elif [[ -f "$HOME/.local/share/applications/screensavers/xfce-floaters.desktop" ]]; then
    _chk FAIL live-saver "user-local xfce-floaters.desktop override → (null) Exec; remove it"
  else
    _chk OK live-saver "stock xfce-floaters.desktop untouched"
  fi

  # Lock command must never be xflock4
  local lc
  lc="$(xq_get xfce4-session /general/LockCommand | head -1)"
  case "$lc" in
    *xflock4*) _chk FAIL live-lock "LockCommand = $lc (never xflock4)" ;;
    "")        _chk WARN live-lock "LockCommand unset (want vaultos-session-lock)" ;;
    *)         _chk OK live-lock "LockCommand = ${lc/#$HOME/\~}" ;;
  esac

  # Desktop Arch spin: autostart through the wrapper; static unless opted in
  local mode found=0
  mode="$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/Vault.OS/desktop-spin" 2>/dev/null || echo reduced)"
  for f in "${XDG_CONFIG_HOME:-$HOME/.config}"/autostart/*.desktop; do
    [[ -f "$f" ]] || continue
    grep -qE '^Exec=.*vaultos-spin-arch' "$f" || continue
    grep -qx 'Hidden=true' "$f" && continue
    found=1
    if grep -qE '^Exec=.*--full' "$f" || ! grep -qE '^Exec=.*vaultos-spin-arch-autostart' "$f"; then
      _chk FAIL live-spin "${f/#$HOME/\~}: $(grep -m1 '^Exec=' "$f") (use vaultos-spin-arch-autostart)"
    else
      _chk OK live-spin "${f##*/} → vaultos-spin-arch-autostart"
    fi
  done
  (( found )) || _chk WARN live-spin "no enabled desktop Arch spin autostart"
  case "$mode" in
    full) _chk OK spin-mode "full (opt-in via ~/.config/Vault.OS/desktop-spin=full)" ;;
    off)  _chk OK spin-mode "off (desktop-spin=off)" ;;
    *)    _chk OK spin-mode "static (default)" ;;
  esac
  if [[ "$mode" != full ]] && pgrep -af 'vaultos-spin-arch' 2>/dev/null | grep -- '--instance desktop' | grep -q -- '--full'; then
    _chk WARN spin-mode "desktop spin running --full without desktop-spin=full (CPU on HD 630)"
  fi

  # Reduced locks with CANON (DESIGN bar #3) — read-only
  local gt wm
  gt="$(xq_get xsettings /Net/ThemeName | head -1)"
  wm="$(xq_get xfwm4 /general/theme | head -1)"
  if [[ "$gt" == "Vault.OS-Reduced" || "$wm" == "Vault.OS-Reduced" || "${THEME_NAME:-}" == "Vault.OS-Reduced" ]]; then
    if [[ "$gt" == "Vault.OS-Reduced" && "$wm" == "Vault.OS-Reduced" && "${THEME_NAME:-}" == "Vault.OS-Reduced" ]]; then
      _chk OK reduced "Reduced: GTK + xfwm + conf all Vault.OS-Reduced"
    else
      _chk WARN reduced "Reduced mismatch: gtk=$gt xfwm=$wm conf=${THEME_NAME:-?} (vault-os ensure-theme)"
    fi
  else
    _chk OK reduced "CANON: gtk=${gt:-?} xfwm=${wm:-?} (Reduced not active)"
  fi
  return 0
}

# Native read-only doctor/lint (src/vaultos-doctor): same checks, same
# output, a fraction of the time. The bash checks above stay the fallback;
# `doctor --fix` always runs here. VAULTOS_DOCTOR=/path overrides,
# VAULTOS_DOCTOR= disables.
_native_doctor() {
  local nd
  if [[ -z "${VAULTOS_DOCTOR+x}" ]]; then
    nd="$(command -v vaultos-doctor 2>/dev/null || true)"
  else
    nd="$VAULTOS_DOCTOR"
  fi
  [[ -n "$nd" && -x "$nd" ]] || return 1
  printf '%s\n' "$nd"
}

_chk_summary() {
  printf '\n%s: %d FAIL, %d WARN\n' "$1" "$_CHK_FAIL" "$_CHK_WARN"
  (( _CHK_FAIL == 0 ))
}

cmd_lint() {
  # vault-os lint [PATH] — repo-only design-bar checks (no X session needed)
  local R="${1:-}"
  if [[ -z "$R" ]]; then
    R="$(_repo_root)" || { printf 'vault-os lint: no checkout found (pass a path)\n' >&2; return 2; }
  fi
  R="$(cd "$R" && pwd)" || return 2
  [[ -d "$R/themes/Vault.OS" ]] || { printf 'vault-os lint: %s is not a Vault.OS checkout\n' "$R" >&2; return 2; }
  printf 'vault-os lint %s\n' "$R"
  printf '───────────────\n'
  _CHK_FAIL=0; _CHK_WARN=0
  _lint_repo "$R"
  _chk_summary lint
}

cmd_doctor() {
  # Read-only diagnosis. No ensure-*, no xfconf writes, no panel/xfdesktop
  # restarts. Repairs live behind `vault-os doctor --fix` (or ensure-*).
  local ec=0 R nd
  if nd="$(_native_doctor)"; then
    "$nd" doctor --repo "$(_repo_root || true)" --cli-version "$VERSION" && return 0 || return $?
  fi
  cmd_status || ec=1
  _CHK_FAIL=0; _CHK_WARN=0
  R="$(_repo_root || true)"
  printf '\nlive rules\n───────────────\n'
  _doctor_live "$R"
  printf '\nrepo lint %s\n───────────────\n' "${R:-(none)}"
  if [[ -n "$R" ]]; then
    _lint_repo "$R"
  else
    _chk SKIP lint "no Vault.OS checkout found (set VAULT_OS_ROOT)"
  fi
  _chk_summary doctor || ec=1
  if [[ "$ec" -ne 0 ]]; then
    printf 'Unhealthy. Session drift: vault-os doctor --fix. Repo FAILs and sudo items above need a commit or a human.\n'
  fi
  return "$ec"
}

cmd_doctor_fix() {
  # Explicit repair pass (was the old default `doctor`). Only restarts the
  # panel when it is actually unhealthy; a healthy panel is left alone.
  log "doctor --fix: diagnose + repair"
  cmd_apply || true
  cmd_ensure_coverage || true
  ensure_xfdesktop || true
  cmd_ensure_panel || true
  xq_set xfce4-panel /panels/panel-1/position -t string -s "$PANEL1_POSITION"
  xq_set xfce4-panel /panels/panel-2/position -t string -s "$PANEL2_POSITION"

  local p2
  p2=$(xq_get xfce4-panel /panels/panel-2/length | head -1)
  if ! pgrep -x xfce4-panel >/dev/null 2>&1 || ! _panel_num_ok "${p2:-0}" 50; then
    warn "panel unhealthy (length=${p2:-?}) — restarting xfce4-panel"
    killall xfce4-panel 2>/dev/null || true
    sleep 0.5
    nohup xfce4-panel >>"${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv/panel.log" 2>&1 &
    sleep 0.8
    xq_set xfce4-panel /panels/panel-1/position -t string -s "$PANEL1_POSITION"
    xq_set xfce4-panel /panels/panel-2/position -t string -s "$PANEL2_POSITION"
  fi

  if cmd_status >/dev/null; then
    local live="$HOME/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml"
    local good="${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv/xfce4-panel.xml.known-good"
    [[ -f "$live" ]] && cp -a "$live" "$good" && log "snapshot panel config"
  fi
}


cmd_install() {
  # User-session install from this checkout (no sudo).
  local root here
  here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  root="$(cd "$here/.." && pwd)"
  [[ -d "$root/themes/Vault.OS" ]] || { err "run from a Vault.OS checkout (missing themes/Vault.OS)"; return 1; }

  log "install from $root"
  mkdir -p "$HOME/.themes" "$HOME/.icons" "$HOME/.local/bin" \
    "$HOME/.local/share/backgrounds/Vault.OS" \
    "$HOME/.local/share/Vault.OS" \
    "${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv"

  cp -a "$root/themes/Vault.OS" "$HOME/.themes/"
  cp -a "$root/themes/Vault.OS-Reduced" "$HOME/.themes/"
  cp -a "$root/icons/Vault.OS" "$HOME/.icons/"
  if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f "$HOME/.icons/Vault.OS" 2>/dev/null || true
  fi

  # Dock plates (panel launchers may point here)
  if [[ -d "$root/source/icons/dock" ]]; then
    mkdir -p "$HOME/.icons/vault-dock"
    cp -a "$root/source/icons/dock/"dock-*.png "$HOME/.icons/vault-dock/" 2>/dev/null || true
  fi

  # Wallpapers / panel plates
  if [[ -d "$root/source/wallpapers" ]]; then
    cp -a "$root/source/wallpapers/." "$HOME/.local/share/backgrounds/Vault.OS/" 2>/dev/null || true
  fi
  # Lock spin frames if shipped
  if [[ -d "$root/source/lock/lock-spin-frames" ]]; then
    mkdir -p "$HOME/.local/share/backgrounds/Vault.OS/lock-spin-frames"
    cp -a "$root/source/lock/lock-spin-frames/." "$HOME/.local/share/backgrounds/Vault.OS/lock-spin-frames/"
  elif [[ -d "$HOME/.local/share/backgrounds/Vault.OS/lock-spin-frames" ]]; then
    :
  fi

  # Terminal theme: full source tree + live reduced seed
  if [[ -d "$root/source/xfce4-terminal" ]]; then
    mkdir -p "$HOME/Vault.OS/source" \
             "$HOME/.config/xfce4/terminal" \
             "$HOME/.local/share/xfce4/terminal/colorschemes" \
             "$HOME/.local/share/Vault.OS" \
             "${XDG_CONFIG_HOME:-$HOME/.config}/Vault.OS"
    cp -a "$root/source/xfce4-terminal/." "$HOME/Vault.OS/source/xfce4-terminal/"
    if [[ -f "$root/source/xfce4-terminal/terminalrc.reduced" ]]; then
      cp -f "$root/source/xfce4-terminal/terminalrc.reduced" \
        "$HOME/.config/xfce4/terminal/terminalrc"
    elif [[ -f "$root/source/xfce4-terminal/terminalrc" ]]; then
      cp -f "$root/source/xfce4-terminal/terminalrc" \
        "$HOME/.config/xfce4/terminal/terminalrc"
    fi
    [[ -f "$root/source/xfce4-terminal/Vault.OS.theme" ]] && \
      cp -f "$root/source/xfce4-terminal/Vault.OS.theme" \
        "$HOME/.local/share/xfce4/terminal/colorschemes/Vault.OS.theme"
    [[ -f "$root/source/xfce4-terminal/scanline.png" ]] && \
      cp -f "$root/source/xfce4-terminal/scanline.png" \
        "$HOME/.local/share/Vault.OS/scanline.png"
    echo reduced > "${XDG_CONFIG_HOME:-$HOME/.config}/Vault.OS/terminal-phosphor"
  fi

  # Control-plane helpers
  local bin
  for bin in vault-os vaultos-lock vaultos-session-lock vaultos-spin-arch \
             vaultos-spin-lock vaultos-spin-lock-run vaultos-spin-arch-autostart vaultos-terminal-phosphor \
             vaultos-root; do
    if [[ -f "$root/bin/$bin" ]]; then
      ln -sfn "$root/bin/$bin" "$HOME/.local/bin/$bin"
      chmod +x "$root/bin/$bin" 2>/dev/null || true
    fi
  done

  # Seed conf (never leave PipBoy defaults in a Vault.OS install)
  local conf="${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv/vault-os.conf"
  if [[ ! -f "$conf" ]] || grep -qE 'THEME_NAME=PipBoy-NV|ICON_THEME=FalloutMojave' "$conf" 2>/dev/null; then
    cat >"$conf" <<EOF
# Vault.OS configuration
THEME_NAME=Vault.OS
ICON_THEME=Vault.OS
WM_THEME=Vault.OS
CURSOR_THEME=Vault.OS
CURSOR_SIZE=24
UI_FONT=Share Tech Mono 10
MONO_FONT=Share Tech Mono 10
TITLE_FONT=Share Tech Mono Bold 10
WALLPAPER=\$HOME/.local/share/backgrounds/Vault.OS/vault-111-base.png
WALLPAPER_FALLBACK=\$HOME/.local/share/backgrounds/Vault.OS/vault-111.png
PANEL1_POSITION=p=6;x=0;y=0
PANEL1_LENGTH=100
PANEL1_SIZE=28
PANEL1_AUTOHIDE=0
PANEL1_BG_IMAGE=\$HOME/.local/share/backgrounds/Vault.OS/panel-top.png
PANEL2_POSITION=p=10;x=0;y=0
PANEL2_LENGTH=100
PANEL2_SIZE=44
PANEL2_AUTOHIDE=0
PANEL2_BG_IMAGE=\$HOME/.local/share/backgrounds/Vault.OS/panel-dock.png
PANEL_BG_STYLE=2
PANEL_BG_R=0.047
PANEL_BG_G=0.059
PANEL_BG_B=0.047
PANEL_BG_A=1.0
PANEL1_ICON_SIZE=16
PANEL2_ICON_SIZE=32
INTRO_ENABLED=0
LOG_FILE=\$HOME/.local/share/fallout-nv/logs/vault-os.log
LOCK_DIR=\$XDG_RUNTIME_DIR/vault-os
EOF
    log "wrote $conf"
  fi

  export VAULT_OS_ROOT="$root"
  # Persist checkout root so ensure-theme finds source/gtk-overlay after reboot
  if grep -q '^VAULT_OS_ROOT=' "$conf" 2>/dev/null; then
    sed -i "s|^VAULT_OS_ROOT=.*|VAULT_OS_ROOT=$root|" "$conf"
  else
    printf '\nVAULT_OS_ROOT=%s\n' "$root" >>"$conf"
  fi
  # Seed GTK overlays from this checkout (HUD import + gtk4.css)
  mkdir -p "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"
  printf '%s\n' \
    '/* Vault.OS user GTK overlay — import theme HUD only; never legacy neon */' \
    "@import url(\"file://$HOME/.themes/Vault.OS/gtk-3.0/hud.css\");" \
    > "$HOME/.config/gtk-3.0/gtk.css"
  if [[ -f "$root/source/gtk-overlay/gtk4.css" ]]; then
    cp -f "$root/source/gtk-overlay/gtk4.css" "$HOME/.config/gtk-4.0/gtk.css"
  fi
  # Prefer ~/.local/bin copy
  export PATH="$HOME/.local/bin:$PATH"
  load_config
  cmd_apply || true
  cmd_ensure_theme || true
  log "user install done — Appearance/WM should show Vault.OS"
  log "screensaver system binary (optional sudo): $root/source/xfce4-screensaver/install-system.sh"
  cmd_status || true
}


cmd_selftest() {
  log "selftest"
  local fail=0
  [[ -x "$HOME/.local/bin/vault-os" ]] || { err "vault-os not executable"; fail=1; }
  [[ -f "$CONF_DEFAULT" ]] || { err "missing conf"; fail=1; }
  [[ -d "$HOME/.themes/$THEME_NAME" ]] || { err "theme dir"; fail=1; }
  have xfconf-query || { err "xfconf-query missing"; fail=1; }
  have mpv || warn "mpv missing"
  if cmd_status; then log "selftest PASS"; else warn "selftest issues — run: vault-os doctor --fix"; fail=1; fi
  return "$fail"
}

_a11y_picom() {
  local want="$1" pc="$HOME/.config/picom.conf"
  [[ -f "$pc" ]] || return 0
  if [[ "$want" == "off" ]]; then
    sed -i 's/^fading *= *true/fading = false/' "$pc"
    sed -i 's/fade = true/fade = false/' "$pc"
  else
    sed -i 's/^fading *= *false/fading = true/' "$pc"
    sed -i 's/fade = false/fade = true/' "$pc"
  fi
  pkill -HUP -x picom 2>/dev/null || true
}

_a11y_env() {
  local dir="${XDG_CONFIG_HOME:-$HOME/.config}/environment.d"
  local f="$dir/vault-os-a11y.conf"
  if [[ "$1" == "on" ]]; then
    mkdir -p "$dir"
    printf '%s\n' 'GTK_A11Y=1' 'NO_AT_BRIDGE=0' >"$f"
  else
    rm -f "$f"
  fi
}

cmd_a11y() {
  local sub="${1:-status}"
  case "$sub" in
    status|"")
      printf 'a11y       %s\n' "$([[ "${A11Y:-0}" == "1" || "$THEME_NAME" == "Vault.OS-Reduced" ]] && echo on || echo off)"
      printf 'theme      %s\n' "$THEME_NAME"
      printf 'motion     %s\n' "${A11Y_MOTION:-on}"
      printf 'text       %s (%s)\n' "${A11Y_TEXT:-normal}" "$UI_FONT"
      printf 'cursor     %s px\n' "${CURSOR_SIZE:-24}"
      printf 'terminal   %s\n' "$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/Vault.OS/terminal-phosphor" 2>/dev/null || echo reduced)"
      ;;
    on)
      log "a11y on — Vault.OS-Reduced, large type, no motion, 32px cursor"
      conf_set THEME_NAME Vault.OS-Reduced
      conf_set WM_THEME Vault.OS-Reduced
      conf_set A11Y 1
      conf_set A11Y_MOTION off
      conf_set A11Y_TEXT large
      conf_set CURSOR_SIZE 32
      conf_set UI_FONT "Share Tech Mono 12"
      conf_set MONO_FONT "Share Tech Mono 12"
      conf_set TITLE_FONT "Share Tech Mono Bold 12"
      mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/Vault.OS"
      echo reduced > "${XDG_CONFIG_HOME:-$HOME/.config}/Vault.OS/terminal-phosphor"
      _a11y_picom off
      _a11y_env on
      load_config
      cmd_apply
      cmd_ensure_theme
      if have vaultos-terminal-phosphor; then
        vaultos-terminal-phosphor reduced >/dev/null 2>&1 || true
      fi
      log "a11y on. New GTK apps pick it up now; open apps may need a restart."
      ;;
    off)
      log "a11y off — Vault.OS canon"
      conf_set THEME_NAME Vault.OS
      conf_set WM_THEME Vault.OS
      conf_set A11Y 0
      conf_set A11Y_MOTION on
      conf_set A11Y_TEXT normal
      conf_set CURSOR_SIZE 24
      conf_set UI_FONT "Share Tech Mono 10"
      conf_set MONO_FONT "Share Tech Mono 10"
      conf_set TITLE_FONT "Share Tech Mono Bold 10"
      _a11y_picom on
      _a11y_env off
      load_config
      cmd_apply
      cmd_ensure_theme
      log "a11y off."
      ;;
    motion)
      local m="${2:-}"
      case "$m" in
        off|0|false) conf_set A11Y_MOTION off; _a11y_picom off; load_config; cmd_apply; log "motion off" ;;
        on|1|true)   conf_set A11Y_MOTION on;  _a11y_picom on;  load_config; cmd_apply; log "motion on" ;;
        *) err "usage: vault-os a11y motion on|off"; return 2 ;;
      esac
      ;;
    text)
      local t="${2:-}"
      case "$t" in
        large|12|big)
          conf_set A11Y_TEXT large
          conf_set UI_FONT "Share Tech Mono 12"
          conf_set MONO_FONT "Share Tech Mono 12"
          conf_set TITLE_FONT "Share Tech Mono Bold 12"
          ;;
        huge|14)
          conf_set A11Y_TEXT huge
          conf_set UI_FONT "Share Tech Mono 14"
          conf_set MONO_FONT "Share Tech Mono 14"
          conf_set TITLE_FONT "Share Tech Mono Bold 14"
          ;;
        normal|10|off)
          conf_set A11Y_TEXT normal
          conf_set UI_FONT "Share Tech Mono 10"
          conf_set MONO_FONT "Share Tech Mono 10"
          conf_set TITLE_FONT "Share Tech Mono Bold 10"
          ;;
        *) err "usage: vault-os a11y text normal|large|huge"; return 2 ;;
      esac
      load_config
      cmd_apply
      cmd_ensure_theme
      log "text ${A11Y_TEXT}"
      ;;
    cursor)
      local s="${2:-}"
      case "$s" in
        24|32|48) conf_set CURSOR_SIZE "$s"; load_config; cmd_apply; log "cursor ${s}px" ;;
        *) err "usage: vault-os a11y cursor 24|32|48"; return 2 ;;
      esac
      ;;
    reduced)
      conf_set THEME_NAME Vault.OS-Reduced
      conf_set WM_THEME Vault.OS-Reduced
      load_config
      cmd_apply
      cmd_ensure_theme
      log "theme Vault.OS-Reduced"
      ;;
    -h|--help|help)
      printf '%s\n' \
        'vault-os a11y — high contrast, larger type, less motion' \
        '' \
        '  vault-os a11y              status' \
        '  vault-os a11y on           Reduced theme + 12pt + 32px cursor + no fade' \
        '  vault-os a11y off          back to Vault.OS canon' \
        '  vault-os a11y reduced      theme only' \
        '  vault-os a11y motion on|off' \
        '  vault-os a11y text normal|large|huge' \
        '  vault-os a11y cursor 24|32|48'
      ;;
    *)
      err "unknown a11y subcommand: $sub (try: vault-os a11y help)"
      return 2
      ;;
  esac
}

usage() {
  printf '%s\n' \
    "vault-os ${VERSION} — Vault.OS XFCE control plane" \
    '' \
    '  session-start   Login orchestrator (theme → panel → intro)' \
    '  apply           Apply theme, icons, cursor, panels' \
    '  ensure-panel    Repair/restore both panels' \
    '  ensure-desktop  Keep xfdesktop running (does not change wallpaper)' \
    '  ensure-theme    Re-assert Vault.OS GTK/icons/wm/panel if drifted' \
    '  ensure-qt       Kvantum + qt5ct/qt6ct (Vault.OS GTK; Qt skin if present)' \
    '  ensure-coverage Qt/sounds/flatpak/chromium theme extras' \
    '  ensure-all      Theme + coverage + desktop + panel (watch timer)' \
    '  coverage        Print theme integration coverage report' \
    '  doctor          Read-only: status + live rules + repo lint (exit 1 on FAIL)' \
    '  doctor --fix    Repair (apply, coverage, panel; restart only if unhealthy), then doctor' \
    '  lint [PATH]     Repo design-bar lint: palette, GTK css, xfwm sync, terminal, saver, spin' \
    '  intro           Play boot intro now' \
    '  intro-enable    Enable intro on login' \
    '  intro-disable   Disable intro on login' \
    '  status          Health check (exit 1 if unhealthy)' \
    '  a11y            High-contrast / large type / reduced motion (on|off|status)' \
    '  install         Copy themes/icons/helpers into ~/.themes ~/.icons ~/.local' \
    '  overlay         Distro identity (status|apply|rollback) — Phase 1' \
    '  (distro CLI is vaultos: status, doctor, update, iso)' \
    '  selftest        Validate installation' \
    '  version         Print version' \
    '' \
    "Config: ${CONF_DEFAULT}"
}

main() {
  # Repo lint runs without a session (CI-safe): no load_config side effects.
  if [[ "${1:-}" == "lint" ]]; then
    local nd R="${2:-}"
    if nd="$(_native_doctor)"; then
      [[ -n "$R" ]] || R="$(_repo_root || true)"
      [[ -n "$R" ]] && exec "$nd" lint "$R"
    fi
    cmd_lint "${2:-}"
    return
  fi
  load_config
  local cmd="${1:-status}"
  case "$cmd" in
    session-start|session) cmd_session_start ;;
    apply|theme)           cmd_apply; cmd_ensure_panel; cmd_ensure_coverage ;;
    ensure-panel|panel)    cmd_ensure_panel ;;
    ensure-desktop|desktop|xfdesktop) cmd_ensure_desktop ;;
    ensure-theme|theme-guard) cmd_ensure_theme ;;
    install) cmd_install ;;
    ensure-qt)             cmd_ensure_qt ;;
    ensure-coverage)       cmd_ensure_coverage ;;
    ensure-all)            cmd_ensure_all ;;
    coverage)              cmd_coverage ;;
    doctor)
      case "${2:-}" in
        "")    cmd_doctor ;;
        --fix) cmd_doctor_fix; cmd_doctor ;;
        *)     err "usage: vault-os doctor [--fix]"; exit 2 ;;
      esac
      ;;
    repair|fix)            cmd_doctor_fix; cmd_status ;;
    intro|play-intro)      cmd_intro ;;
    intro-enable|enable)   cmd_intro_enable ;;
    intro-disable|disable) cmd_intro_disable ;;
    status|st)             cmd_status ;;
    a11y|accessability|accessibility)
      shift
      cmd_a11y "${1:-status}" "${2:-}"
      ;;
    overlay)
      shift
      _script="$(readlink -f "${BASH_SOURCE[0]}")"
      _root="$(cd "$(dirname "$_script")/.." && pwd)"
      exec "$_root/overlay/identity-apply.sh" "${1:-status}"
      ;;
    selftest|test)         cmd_selftest ;;
    version|-V|--version)  echo "vault-os $VERSION" ;;
    -h|--help|help)        usage ;;
    *)                     usage; exit 2 ;;
  esac
}

main "$@"
