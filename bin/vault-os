#!/usr/bin/env bash
# vault-os — production control plane for Vault.OS XFCE stack
set -euo pipefail

readonly VERSION="1.5.15"
readonly CONF_DEFAULT="${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv/vault-os.conf"

export DISPLAY="${DISPLAY:-:0}"
export XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

load_config() {
  THEME_NAME=Vault.OS
  ICON_THEME=Vault.OS
  WM_THEME=Vault.OS
  CURSOR_THEME=Vault.OS
  CURSOR_SIZE=24
  UI_FONT="Share Tech Mono 10"
  MONO_FONT="Share Tech Mono 10"
  TITLE_FONT="Share Tech Mono Bold 10"
  WALLPAPER="$HOME/.local/share/backgrounds/Vault.OS/vault-111-base.png"
  WALLPAPER_FALLBACK="$HOME/.local/share/backgrounds/Vault.OS/vault-111.png"
  PANEL1_POSITION="p=6;x=0;y=0"
  PANEL1_LENGTH=100
  PANEL1_SIZE=28
  PANEL1_AUTOHIDE=0
  PANEL1_BG_IMAGE="$HOME/.local/share/backgrounds/Vault.OS/panel-top.png"
  PANEL2_POSITION="p=10;x=0;y=0"
  PANEL2_LENGTH=100
  PANEL2_SIZE=44
  PANEL2_AUTOHIDE=0
  PANEL2_BG_IMAGE="$HOME/.local/share/backgrounds/Vault.OS/panel-dock.png"
  PANEL_BG_STYLE=2
  PANEL_BG_R=0.047
  PANEL_BG_G=0.059
  PANEL_BG_B=0.047
  PANEL_BG_A=1.0
  PANEL1_ICON_SIZE=16
  PANEL2_ICON_SIZE=32
  INTRO_FILE="$HOME/.local/share/fallout-nv/boot-intro.mp4"
  INTRO_VOLUME=90
  INTRO_ENABLED=0
  LOG_FILE="$HOME/.local/share/fallout-nv/logs/vault-os.log"
  LOCK_DIR="${XDG_RUNTIME_DIR}/vault-os"

  if [[ -f "$CONF_DEFAULT" ]]; then
    set +u
    # shellcheck disable=SC1090
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ "$line" =~ ^[[:space:]]*# ]] && continue
      [[ -z "${line// }" ]] && continue
      key="${line%%=*}"
      val="${line#*=}"
      key="${key// /}"
      [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
      # expand $HOME and $XDG_RUNTIME_DIR
      val="${val//\$HOME/$HOME}"
      val="${val//\$XDG_RUNTIME_DIR/$XDG_RUNTIME_DIR}"
      printf -v "$key" '%s' "$val"
    done < "$CONF_DEFAULT"
    set -u
  fi
  mkdir -p "$(dirname "$LOG_FILE")" "$LOCK_DIR" \
    "${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv" \
    "$HOME/.local/state/vault-os"
}

_ts() { date -Iseconds 2>/dev/null || date '+%Y-%m-%dT%H:%M:%S'; }
_rotate_log() {
  [[ -n "${LOG_FILE:-}" && -f "$LOG_FILE" ]] || return 0
  local sz
  sz=$(stat -c '%s' "$LOG_FILE" 2>/dev/null || echo 0)
  if (( sz > 2097152 )); then
    mv -f "$LOG_FILE" "${LOG_FILE}.old" 2>/dev/null || true
  fi
}
log()  { _rotate_log; printf '%s INFO  %s\n' "$(_ts)" "$*" >>"$LOG_FILE"; printf '[vault-os] %s\n' "$*"; }
warn() { _rotate_log; printf '%s WARN  %s\n' "$(_ts)" "$*" >>"$LOG_FILE"; printf '[vault-os] WARN: %s\n' "$*" >&2; }
err()  { _rotate_log; printf '%s ERROR %s\n' "$(_ts)" "$*" >>"$LOG_FILE"; printf '[vault-os] ERROR: %s\n' "$*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }

_gtk_overlay_dir() {
  # Prefer conf/env checkout, then bin-adjacent repo, then ~/Vault.OS
  local cand
  for cand in "${VAULT_OS_ROOT:-}" "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)" "$HOME/Vault.OS"; do
    [[ -n "$cand" && -d "$cand/source/gtk-overlay" ]] && { printf '%s\n' "$cand/source/gtk-overlay"; return 0; }
  done
  printf '%s\n' "$HOME/Vault.OS/source/gtk-overlay"
}


has_share_tech_mono() {
  # File check first (fast, no pipefail issues under set -e)
  [[ -f "$HOME/.local/share/fonts/ShareTechMono/ShareTechMono-Regular.ttf" ]] && return 0
  [[ -f "$HOME/.local/share/fonts/pipboy/ShareTechMono-Regular.ttf" ]] && return 0
  if fc-list : family 2>/dev/null | grep -Fqi "Share Tech Mono"; then return 0; fi
  if fc-list 2>/dev/null | grep -Fqi "ShareTechMono"; then return 0; fi
  return 1
}


_panel_num_ok() { awk -v v="${1:-0}" -v m="${2:-0}" 'BEGIN{ exit !(v+0 >= m) }'; }

_xq_vals_equal() {
  # String match, or numeric match so 100 == 100.000000.
  local a="$1" b="$2"
  [[ "$a" == "$b" ]] && return 0
  [[ "$a" =~ ^-?[0-9]+([.][0-9]+)?$ && "$b" =~ ^-?[0-9]+([.][0-9]+)?$ ]] || return 1
  awk -v a="$a" -v b="$b" 'BEGIN{exit !(a+0==b+0)}'
}

xq_set() {
  # Set in place. Skip when already equal (avoids xfwm/panel reload storms).
  # Create if missing. Only delete+recreate on a type mismatch.
  have xfconf-query || return 0
  local ch="$1" prop="$2"; shift 2
  local vals=() i
  local raw=("$@")
  for ((i=0; i<${#raw[@]}; i++)); do
    if [[ "${raw[i]}" == "-s" ]]; then
      vals+=("${raw[i+1]}")
      i=$((i+1))
    fi
  done
  if ((${#vals[@]} > 0)); then
    local cur=() line
    while IFS= read -r line; do
      [[ -z "$line" || "$line" == "Value is an array"* ]] && continue
      cur+=("$line")
    done < <(xfconf-query -c "$ch" -p "$prop" 2>/dev/null || true)
    if ((${#cur[@]} == ${#vals[@]})); then
      local same=1
      for i in "${!vals[@]}"; do
        if ! _xq_vals_equal "${cur[i]}" "${vals[i]}"; then
          same=0
          break
        fi
      done
      if ((same)); then
        return 0
      fi
    fi
  fi
  if xfconf-query -c "$ch" -p "$prop" "$@" 2>/dev/null; then
    return 0
  fi
  if xfconf-query -c "$ch" -p "$prop" -n "$@" 2>/dev/null; then
    return 0
  fi
  xfconf-query -c "$ch" -p "$prop" -r 2>/dev/null || true
  xfconf-query -c "$ch" -p "$prop" -n "$@" 2>/dev/null || true
}

write_vault_os_env() {
  local dest="$HOME/.config/environment.d/vault-os.conf"
  mkdir -p "$(dirname "$dest")"
  local tmp
  tmp="$(mktemp "${TMPDIR:-/tmp}/vault-os-env.XXXXXX")"
  {
    printf '%s\n' \
      "GTK_THEME=${THEME_NAME}" \
      "QT_QPA_PLATFORMTHEME=qt5ct" \
      "QT_STYLE_OVERRIDE=kvantum" \
      "XCURSOR_THEME=${CURSOR_THEME:-Vault.OS}" \
      "XCURSOR_SIZE=${CURSOR_SIZE:-24}" \
      "GTK_MODULES=canberra-gtk-module" \
      "LIBVA_DRIVER_NAME=iHD" \
      "LIBVA_DRIVERS_PATH=/usr/lib/dri" \
      "MOZ_X11_EGL=1"
    if [[ -f "$dest" ]]; then
      local k
      while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" == *=* ]] || continue
        k="${line%%=*}"
        case "$k" in
          GTK_THEME|QT_QPA_PLATFORMTHEME|QT_STYLE_OVERRIDE|XCURSOR_THEME|XCURSOR_SIZE|GTK_MODULES|LIBVA_DRIVER_NAME|LIBVA_DRIVERS_PATH|MOZ_X11_EGL) continue ;;
        esac
        printf '%s\n' "$line"
      done < "$dest"
    fi
  } >"$tmp"
  mv -f "$tmp" "$dest"
}
xq_get() {
  have xfconf-query || { echo ""; return 0; }
  xfconf-query -c "$1" -p "$2" 2>/dev/null || true
}

ensure_xfdesktop() {
  # Keep xfdesktop running. Never touch last-image / backdrop — the user
  # owns the wallpaper (Settings → Desktop).
  export DISPLAY="${DISPLAY:-:0}"
  export XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"
  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"

  if pgrep -x xfdesktop >/dev/null 2>&1; then
    return 0
  fi

  warn "xfdesktop not running — starting (wallpaper guard)"
  mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv"
  local lock="${XDG_RUNTIME_DIR}/vault-os/xfdesktop.start.lock"
  mkdir -p "$(dirname "$lock")"
  exec 9>"$lock"
  if ! flock -n 9; then
    sleep 0.5
    pgrep -x xfdesktop >/dev/null 2>&1 && return 0
  fi

  nohup xfdesktop --disable-wm-check \
    >>"${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv/xfdesktop.log" 2>&1 &
  sleep 0.9

  if ! pgrep -x xfdesktop >/dev/null 2>&1; then
    nohup xfdesktop \
      >>"${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv/xfdesktop.log" 2>&1 &
    sleep 0.9
  fi

  if pgrep -x xfdesktop >/dev/null 2>&1; then
    log "xfdesktop started pid=$(pgrep -x xfdesktop | head -1)"
    return 0
  fi
  err "failed to start xfdesktop — see ~/.config/fallout-nv/xfdesktop.log"
  return 1
}

cmd_ensure_desktop() {
  log "ensure desktop (keep xfdesktop running)"
  load_config 2>/dev/null || true
  ensure_xfdesktop
}



intro_mpv_running() {
  # Match mpv by PID + cmdline without killing self; only look at mpv processes
  local pid cmd
  for pid in $(pgrep -x mpv 2>/dev/null || true); do
    cmd=$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)
    case "$cmd" in
      *boot-intro*|*FNVIntro*) return 0 ;;
    esac
  done
  return 1
}

stop_intro_mpv() {
  local pid cmd
  for pid in $(pgrep -x mpv 2>/dev/null || true); do
    cmd=$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)
    case "$cmd" in
      *boot-intro*|*FNVIntro*) kill "$pid" 2>/dev/null || true ;;
    esac
  done
}

cmd_apply() {
  log "apply theme stack ($THEME_NAME / $ICON_THEME / $CURSOR_THEME)"

  # Font fallback if Share Tech Mono missing
  if has_share_tech_mono; then
    UI_FONT="Share Tech Mono 10"
    MONO_FONT="Share Tech Mono 10"
    TITLE_FONT="Share Tech Mono Bold 10"
  elif fc-list : family 2>/dev/null | grep -Fqi "JetBrains Mono"; then
    UI_FONT="JetBrains Mono 10"
    MONO_FONT="JetBrains Mono 10"
    TITLE_FONT="JetBrains Mono Bold 10"
    warn "Share Tech Mono missing — using JetBrains Mono"
  fi

  xq_set xsettings /Net/ThemeName -t string -s "$THEME_NAME"
  xq_set xsettings /Net/IconThemeName -t string -s "$ICON_THEME"
  xq_set xsettings /Gtk/FontName -t string -s "$UI_FONT"
  xq_set xsettings /Gtk/MonospaceFontName -t string -s "$MONO_FONT"
  xq_set xsettings /Gtk/CursorThemeName -t string -s "${CURSOR_THEME:-Vault.OS}"
  xq_set xsettings /Gtk/CursorThemeSize -t int -s "${CURSOR_SIZE:-24}"
  # Sound follows Vault.OS (or mute) — do not bind PipBoy-NV audio unless theme is PipBoy-NV
  if [[ -d "$HOME/.local/share/sounds/Vault.OS" ]]; then
    xq_set xsettings /Net/SoundThemeName -t string -s "Vault.OS"
    xq_set xsettings /Net/EnableEventSounds -t bool -s true
  elif [[ "${THEME_NAME:-Vault.OS}" == "PipBoy-NV" && -d "$HOME/.local/share/sounds/PipBoy-NV" ]]; then
    xq_set xsettings /Net/SoundThemeName -t string -s "PipBoy-NV"
    xq_set xsettings /Net/EnableEventSounds -t bool -s true
  else
    xq_set xsettings /Net/EnableEventSounds -t bool -s false
    if [[ "$(xq_get xsettings /Net/SoundThemeName | head -1)" == "PipBoy-NV" ]]; then
      xq_set xsettings /Net/SoundThemeName -t string -s "freedesktop"
    fi
  fi
  xq_set xsettings /Net/EnableInputFeedbackSounds -t bool -s false
  # XWM-03: doors follow GTK theme name when Reduced/CANON
  if [[ "$THEME_NAME" == "Vault.OS-Reduced" ]]; then
    WM_THEME="Vault.OS-Reduced"
  elif [[ "$THEME_NAME" == "Vault.OS" ]]; then
    WM_THEME="Vault.OS"
  fi
  xq_set xfwm4 /general/theme -t string -s "$WM_THEME"
  xq_set xfwm4 /general/title_font -t string -s "$TITLE_FONT"
  xq_set xfwm4 /general/workspace_names -t string -s "STAT" -t string -s "DATA" -t string -s "ITEM" -t string -s "MAP"
  xq_set xfwm4 /general/workspace_count -t int -s 4

  # Wallpaper is user-owned. Do not write last-image here.

  # Desktop icon label colors (CRT green)
  xq_set xfce4-desktop /desktop-icons/label-text-color \
    -t double -s 0.72 -t double -s 1.0 -t double -s 0.80 -t double -s 1.0
  xq_set xfce4-desktop /desktop-icons/label-background-color \
    -t double -s 0.027 -t double -s 0.051 -t double -s 0.035 -t double -s 0.75
  xq_set xfce4-desktop /desktop-icons/use-custom-label-text-color -t bool -s true
  xq_set xfce4-desktop /desktop-icons/use-custom-label-background-color -t bool -s true

  # Notifications (avoid /primary-monitor — type varies by xfce4-notifyd version)
  # Drop legacy wrong-typed props if present
  if have xfconf-query; then
    for bad in /primary-monitor; do
      xfconf-query -c xfce4-notifyd -p "$bad" -r 2>/dev/null || true
    done
  fi
  # notify chrome lives only under ~/.themes/Vault.OS/xfce-notify-4.0 (no Reduced pack)
  local notify_theme="Vault.OS"
  [[ "${THEME_NAME:-Vault.OS}" == "PipBoy-NV" ]] && notify_theme="PipBoy-NV"
  xq_set xfce4-notifyd /theme -t string -s "$notify_theme"
  xq_set xfce4-notifyd /do-fadeout -t bool -s false
  xq_set xfce4-notifyd /do-slideout -t bool -s false
  xq_set xfce4-notifyd /initial-opacity -t double -s 1.0
  # Modern xfce4-notifyd uses string enum: top-left|bottom-left|top-right|bottom-right
  # Older builds used int — detect and set the correct type for this system.
  if have xfconf-query; then
    cur=$(xfconf-query -c xfce4-notifyd -p /notify-location 2>/dev/null || true)
    if [[ -z "$cur" ]]; then
      # Prefer string (current xfce4-notifyd); fall back to int
      xfconf-query -c xfce4-notifyd -p /notify-location -n -t string -s "bottom-left" 2>/dev/null \
        || xfconf-query -c xfce4-notifyd -p /notify-location -n -t int -s 1 2>/dev/null \
        || true
    elif [[ "$cur" =~ ^[0-9]+$ ]]; then
      : # numeric already — leave it
    else
      : # string already — leave it
    fi
  fi

  # Clock format only if plugin-8 is actually a clock (IDs drift)
  local p8
  p8=$(xq_get xfce4-panel /plugins/plugin-8 | head -1)
  if [[ "$p8" == *clock* ]]; then
    xq_set xfce4-panel /plugins/plugin-8/digital-time-format -t string -s "%I:%M %p  %a %d"
    xq_set xfce4-panel /plugins/plugin-8/digital-format -t string -s "%I:%M %p  %a %d"
  fi

  # GTK settings.ini
  mkdir -p "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"
  printf '%s\n' \
    '[Settings]' \
    "gtk-theme-name=${THEME_NAME}" \
    "gtk-icon-theme-name=${ICON_THEME}" \
    "gtk-font-name=${UI_FONT}" \
    "gtk-cursor-theme-name=${CURSOR_THEME:-Adwaita}" \
    "gtk-cursor-theme-size=${CURSOR_SIZE:-24}" \
    'gtk-application-prefer-dark-theme=1' \
    'gtk-xft-antialias=1' \
    'gtk-xft-hinting=1' \
    'gtk-xft-hintstyle=hintslight' \
    'gtk-xft-rgba=rgb' \
    'gtk-enable-animations=true' \
    > "$HOME/.config/gtk-3.0/settings.ini"
  cp -f "$HOME/.config/gtk-3.0/settings.ini" "$HOME/.config/gtk-4.0/settings.ini"



  # GTK user overlays — HUD import only; never legacy neon; spinner stays in theme
  local overlay_src; overlay_src="$(_gtk_overlay_dir)"
  local hud_theme="$THEME_NAME"
  case "$hud_theme" in
    Vault.OS|Vault.OS-Reduced) ;;
    *) hud_theme="Vault.OS" ;;
  esac
  mkdir -p "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"
  printf '%s
' \
    '/* Vault.OS user GTK overlay — import theme HUD only; never PipBoy CSS */' \
    '/* Spinner fix: theme gtk-3.0/gtk-3.20 only (no fighting user override). */' \
    "@import url(\"file://$HOME/.themes/${hud_theme}/gtk-3.0/hud.css\");" \
    > "$HOME/.config/gtk-3.0/gtk.css"
  if [[ -f "$overlay_src/gtk4.css" ]]; then
    cp -f "$overlay_src/gtk4.css" "$HOME/.config/gtk-4.0/gtk.css"
  fi


  # Flatpak GTK/icon theme alignment
  if have flatpak; then
    flatpak override --user --env=GTK_THEME="$THEME_NAME" 2>/dev/null || true
    flatpak override --user --env=ICON_THEME="$ICON_THEME" 2>/dev/null || true
    flatpak override --user --filesystem=xdg-config/gtk-3.0:ro 2>/dev/null || true
    flatpak override --user --filesystem=xdg-config/gtk-4.0:ro 2>/dev/null || true
    flatpak override --user --filesystem=~/.themes:ro 2>/dev/null || true
    flatpak override --user --filesystem=~/.icons:ro 2>/dev/null || true
    flatpak override --user --filesystem=~/.local/share/icons:ro 2>/dev/null || true
  fi

  # Qt (qt5ct/qt6ct) — keep in sync
  for qt in qt5ct qt6ct; do
    local qtc="$HOME/.config/$qt/$qt.conf"
    mkdir -p "$HOME/.config/$qt"
    if [[ -f "$qtc" ]]; then
      sed -i "s|^icon_theme=.*|icon_theme=${ICON_THEME}|" "$qtc" 2>/dev/null || true
      sed -i "s|^style=.*|style=kvantum|" "$qtc" 2>/dev/null || true
    else
      printf '%s\n' \
        '[Appearance]' \
        'custom_palette=false' \
        "icon_theme=${ICON_THEME}" \
        'standard_dialogs=default' \
        'style=kvantum' \
        '' \
        '[Fonts]' \
        "fixed=\"${MONO_FONT%,*},10,-1,5,50,0,0,0,0,0\"" \
        "general=\"${UI_FONT%,*},10,-1,5,50,0,0,0,0,0\"" \
        > "$qtc"
    fi
  done

  write_vault_os_env

  # Terminal — vaultos-terminal-phosphor (CANON palette)
  # Modes: full|reduced|clear. Default reduced. See ~/Vault.OS/source/xfce4-terminal/A11Y.md
  if have vaultos-terminal-phosphor; then
    local phos_mode
    phos_mode="$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/Vault.OS/terminal-phosphor" 2>/dev/null || echo reduced)"
    case "$phos_mode" in full|reduced|clear) ;; *) phos_mode=reduced ;; esac
    vaultos-terminal-phosphor "$phos_mode" >/dev/null || true
    xq_set xfce4-terminal /title-initial -t string -s "ROBCO 76"
    xq_set xfce4-terminal /misc-borders-default -t bool -s true
  elif have xfconf-query; then
    # Fallback CANON if dial missing
    local pal="#070807;#C41E3A;#0E8A3A;#FFB000;#2A332A;#C41E3A;#1AFF6B;#8A8F86;#121612;#C41E3A;#1AFF6B;#FFB000;#8A8F86;#C41E3A;#1AFF6B;#C7C9C5"
    xq_set xfce4-terminal /color-use-theme -t bool -s false
    xq_set xfce4-terminal /color-foreground -t string -s "#1AFF6B"
    xq_set xfce4-terminal /color-background -t string -s "#070807"
    xq_set xfce4-terminal /color-cursor -t string -s "#1AFF6B"
    xq_set xfce4-terminal /color-bold -t string -s "#66FF9C"
    xq_set xfce4-terminal /color-palette -t string -s "$pal"
    xq_set xfce4-terminal /background-mode -t string -s "TERMINAL_BACKGROUND_SOLID"
    xq_set xfce4-terminal /misc-borders-default -t bool -s true
    xq_set xfce4-terminal /font-name -t string -s "Share Tech Mono 11"
    xq_set xfce4-terminal /title-initial -t string -s "ROBCO 76"
  fi

  ensure_xfdesktop || true
  log "apply complete"
}


cmd_ensure_panel() {
  log "ensure panels"

  # Always write FULL position strings — XFCE truncating to p=N loses the bottom bar
  xq_set xfce4-panel /panels -t int -s 1 -t int -s 2

  xq_set xfce4-panel /panels/panel-1/position -t string -s "$PANEL1_POSITION"
  xq_set xfce4-panel /panels/panel-1/length -t double -s "$PANEL1_LENGTH"
  xq_set xfce4-panel /panels/panel-1/size -t int -s "$PANEL1_SIZE"
  xq_set xfce4-panel /panels/panel-1/autohide-behavior -t int -s "$PANEL1_AUTOHIDE"
  xq_set xfce4-panel /panels/panel-1/position-locked -t bool -s true
  xq_set xfce4-panel /panels/panel-1/mode -t int -s 0

  xq_set xfce4-panel /panels/panel-2/position -t string -s "$PANEL2_POSITION"
  xq_set xfce4-panel /panels/panel-2/length -t double -s "$PANEL2_LENGTH"
  xq_set xfce4-panel /panels/panel-2/size -t int -s "$PANEL2_SIZE"
  xq_set xfce4-panel /panels/panel-2/autohide-behavior -t int -s "$PANEL2_AUTOHIDE"
  xq_set xfce4-panel /panels/panel-2/position-locked -t bool -s true
  xq_set xfce4-panel /panels/panel-2/mode -t int -s 0

  # Panel chrome — prefer textured images (style 2), color fallback (style 1)
  local bg_style="${PANEL_BG_STYLE:-2}"
  xq_set xfce4-panel /panels/panel-1/background-style -t int -s "$bg_style"
  xq_set xfce4-panel /panels/panel-2/background-style -t int -s "$bg_style"
  if [[ -f "${PANEL1_BG_IMAGE:-}" ]]; then
    xq_set xfce4-panel /panels/panel-1/background-image -t string -s "$PANEL1_BG_IMAGE"
  fi
  if [[ -f "${PANEL2_BG_IMAGE:-}" ]]; then
    xq_set xfce4-panel /panels/panel-2/background-image -t string -s "$PANEL2_BG_IMAGE"
  fi
  local p
  for p in 1 2; do
    if have xfconf-query; then
      if ! xfconf-query -c xfce4-panel -p "/panels/panel-${p}/background-rgba" >/dev/null 2>&1; then
        xfconf-query -c xfce4-panel -p "/panels/panel-${p}/background-rgba" -n \
          -t double -s "$PANEL_BG_R" \
          -t double -s "$PANEL_BG_G" \
          -t double -s "$PANEL_BG_B" \
          -t double -s "$PANEL_BG_A" 2>/dev/null || true
      fi
    fi
  done
  xq_set xfce4-panel /panels/panel-1/icon-size -t int -s "${PANEL1_ICON_SIZE:-16}"
  xq_set xfce4-panel /panels/panel-2/icon-size -t int -s "${PANEL2_ICON_SIZE:-32}" 

  local len2
  len2=$(xq_get xfce4-panel /panels/panel-2/length | head -1)
  if ! _panel_num_ok "${len2:-0}" 50; then
    warn "panel-2 length bad ($len2) — re-asserting via xfconf (not overwriting live XML)"
    xq_set xfce4-panel /panels/panel-2/length -t double -s "$PANEL2_LENGTH"
  fi

  if ! pgrep -x xfce4-panel >/dev/null 2>&1; then
    warn "xfce4-panel dead — starting"
    local good="${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv/xfce4-panel.xml.known-good"
    local live="$HOME/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml"
    if [[ -f "$good" ]]; then
      [[ -f "$live" ]] && cp -a "$live" "${live}.bak"
      cp -a "$good" "$live"
    fi
    nohup xfce4-panel >>"${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv/panel.log" 2>&1 &
    sleep 0.7
  fi

  # Re-assert full positions (daemon may rewrite to p=N only)
  xq_set xfce4-panel /panels/panel-1/position -t string -s "$PANEL1_POSITION"
  xq_set xfce4-panel /panels/panel-2/position -t string -s "$PANEL2_POSITION"

  # Keep Whisker sizing professional (no oversized menu)
  if xq_get xfce4-panel /plugins/plugin-1 2>/dev/null | grep -qx whiskermenu; then
    xq_set xfce4-panel /plugins/plugin-1/menu-width -t int -s 320
    xq_set xfce4-panel /plugins/plugin-1/menu-height -t int -s 420
    xq_set xfce4-panel /plugins/plugin-1/menu-opacity -t int -s 100
  fi

  if pgrep -x xfce4-panel >/dev/null 2>&1; then
    log "panels OK (pid $(pgrep -x xfce4-panel | head -1))"
    return 0
  fi
  err "failed to start xfce4-panel"
  return 1
}

cmd_intro() {
  if [[ "${INTRO_ENABLED:-0}" != "1" ]] || [[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv/skip-boot-intro" ]]; then
    log "intro disabled"
    return 0
  fi
  local intro="$INTRO_FILE"
  [[ -f "$intro" ]] || intro="$HOME/.local/share/fallout-nv/FNVIntro-1080p-1m26s.mp4"
  if [[ ! -f "$intro" ]]; then warn "intro media missing"; return 0; fi
  have mpv || { warn "mpv missing"; return 0; }
  if intro_mpv_running; then log "intro already playing"; return 0; fi

  local lock="$LOCK_DIR/intro.lock"
  log "intro start: $intro"
  (
    flock -n 200 || exit 0
    local i
    for i in $(seq 1 60); do
      xset q &>/dev/null && break
      sleep 0.05
    done
    exec mpv \
      --fullscreen \
      --force-window=immediate \
      --no-border \
      --ontop \
      --cursor-autohide=always \
      --no-osc \
      --osd-level=0 \
      --really-quiet \
      --keep-open=no \
      --stop-screensaver \
      --hwdec=auto-safe \
      --vo=gpu \
      --profile=fast \
      --volume="${INTRO_VOLUME:-90}" \
      --title="Fallout: New Vegas — Opening" \
      "$intro"
  ) 200>"$lock" &
  disown 2>/dev/null || true
}

cmd_intro_enable() {
  rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv/skip-boot-intro"
  [[ -f "$CONF_DEFAULT" ]] && sed -i 's/^INTRO_ENABLED=.*/INTRO_ENABLED=1/' "$CONF_DEFAULT" 2>/dev/null || true
  log "intro enabled"
}
cmd_intro_disable() {
  mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv"
  touch "${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv/skip-boot-intro"
  [[ -f "$CONF_DEFAULT" ]] && sed -i 's/^INTRO_ENABLED=.*/INTRO_ENABLED=0/' "$CONF_DEFAULT" 2>/dev/null || true
  stop_intro_mpv
  log "intro disabled"
}


cmd_ensure_theme() {
  # Single lock path: conf THEME_NAME wins. Vault.OS-Reduced only if conf says so.
  load_config
  local want_t="${THEME_NAME:-Vault.OS}"
  local want_i="${ICON_THEME:-Vault.OS}"
  local want_w="${WM_THEME:-Vault.OS}"
  local want_c="${CURSOR_THEME:-Vault.OS}"
  case "$want_t" in Vault.OS|Vault.OS-Reduced) ;; *) want_t="Vault.OS" ;; esac
  # XWM-03: Reduced GTK must not keep CANON doors — follow THEME_NAME for xfwm
  if [[ "$want_t" == "Vault.OS-Reduced" ]]; then
    want_w="Vault.OS-Reduced"
  elif [[ "$want_t" == "Vault.OS" && "$want_w" == "Vault.OS-Reduced" ]]; then
    want_w="Vault.OS"
  fi
  local cur_t cur_i cur_w cur_c
  cur_t=$(xq_get xsettings /Net/ThemeName | head -1)
  cur_i=$(xq_get xsettings /Net/IconThemeName | head -1)
  cur_w=$(xq_get xfwm4 /general/theme | head -1)
  cur_c=$(xq_get xsettings /Gtk/CursorThemeName | head -1)

  local bad=0
  [[ "$cur_t" == "$want_t" ]] || bad=1
  [[ "$cur_i" == "$want_i" ]] || bad=1
  [[ "$cur_w" == "$want_w" ]] || bad=1
  [[ "$cur_c" == "$want_c" ]] || bad=1
  case "$cur_t" in Adwaita|Adwaita-dark|Greybird|Default|PipBoy-NV|"" ) bad=1 ;; esac
  case "$cur_w" in Adwaita|Greybird|Default|PipBoy-NV|"" ) bad=1 ;; esac
  case "$cur_i" in Adwaita|hicolor|FalloutMojave|PipBoy-NV|"" ) bad=1 ;; esac

  if [[ "$bad" -eq 1 ]]; then
    warn "theme drift (gtk='$cur_t' icons='$cur_i' wm='$cur_w') — reapplying $want_t"
    cmd_apply
    pgrep -x xfsettingsd >/dev/null 2>&1 && killall -HUP xfsettingsd 2>/dev/null || true
    if pgrep -x xfwm4 >/dev/null 2>&1; then
      cur_w=$(xq_get xfwm4 /general/theme | head -1)
      if [[ "$cur_w" != "$want_w" ]]; then
        xq_set xfwm4 /general/theme -t string -s "$want_w"
      fi
    fi
  else
    # Values already match. Do not write xfconf — xfwm/panel treat a
    # same-value set as a theme reload and eventually stop mapping windows.
    :
  fi

  # Pin notify + panel plates only when they drifted (xq_set is a no-op if equal).
  xq_set xfce4-notifyd /theme -t string -s "Vault.OS"
  local top="${PANEL1_BG_IMAGE:-$HOME/.local/share/backgrounds/Vault.OS/panel-top.png}"
  local dock="${PANEL2_BG_IMAGE:-$HOME/.local/share/backgrounds/Vault.OS/panel-dock.png}"
  xq_set xfce4-panel /panels/panel-1/background-image -t string -s "$top"
  xq_set xfce4-panel /panels/panel-2/background-image -t string -s "$dock"
  xq_set xfce4-panel /panels/panel-1/background-style -t int -s "${PANEL_BG_STYLE:-2}"
  xq_set xfce4-panel /panels/panel-2/background-style -t int -s "${PANEL_BG_STYLE:-2}"
  xq_set xfce4-panel /panels/panel-1/size -t int -s "${PANEL1_SIZE:-28}"
  # xfce4-session LockScreen-before-shutdown hangs forever if the saver is wedged.
  xq_set xfce4-session /shutdown/LockScreen -t bool -s false
  # Must NOT be "xflock4": stock xflock4 calls Session.Lock which runs LockCommand.
  xq_set xfce4-session /general/LockCommand -t string -s "xfce4-screensaver-command --lock"
  # Let logind own the power button so a short press still works when GTK is dead.
  xq_set xfce4-power-manager /xfce4-power-manager/logind-handle-power-key -t bool -s true
  # 5-minute blank + 15-minute DPMS locked movies. 0 = never on AC.
  xq_set xfce4-power-manager /xfce4-power-manager/blank-on-ac -t int -s 0
  xq_set xfce4-power-manager /xfce4-power-manager/dpms-on-ac-sleep -t int -s 0
  xq_set xfce4-power-manager /xfce4-power-manager/dpms-on-ac-off -t int -s 0
  if xq_get xfce4-panel /plugins/plugin-1 2>/dev/null | grep -qx whiskermenu; then
    local pwr="$HOME/.local/bin/vault-os-power"
    if [[ -x "$pwr" ]]; then
      xq_set xfce4-panel /plugins/plugin-1/command-logout -t string -s "$pwr logout"
      xq_set xfce4-panel /plugins/plugin-1/command-restart -t string -s "$pwr reboot"
      xq_set xfce4-panel /plugins/plugin-1/command-shutdown -t string -s "$pwr shutdown"
    fi
  fi
  # Custom ~/.local saver .desktops are NOT scanned by xfce4-screensaver.
  # System desktop vaultos-arch-spin.desktop exists but Hidden=true + missing
  # /usr/lib binary → (null) command. Until sudo fixes that, pin stock
  # slideshow to lock-slides spin frames (Y-axis foreshorten sequence).
  local saver_want="screensavers-vaultos-arch-spin"
  local saver_cur
  saver_cur=$(xq_get xfce4-screensaver /saver/themes/list | tail -1)
  if [[ "$saver_cur" != "$saver_want" ]]; then
    xfconf-query -c xfce4-screensaver -p /saver/themes/list --force-array -t string -s "$saver_want" 2>/dev/null \
      || xfconf-query -c xfce4-screensaver -p /saver/themes/list -n -a -t string -s "$saver_want" 2>/dev/null \
      || true
  fi
  xq_set xfce4-screensaver /screensavers/xfce-personal-slideshow/images-location -t string -s "$HOME/.local/share/backgrounds/Vault.OS/lock-spin-frames"
  xq_set xfce4-screensaver /screensavers/xfce-personal-slideshow/location -t string -s "$HOME/.local/share/backgrounds/Vault.OS/lock-spin-frames"
  xq_set xfce4-screensaver /lock/enabled -t bool -s true
  xq_set xfce4-screensaver /lock/saver-activation/enabled -t bool -s true
  if [[ "$bad" -eq 1 ]] && have vaultos-terminal-phosphor; then
    local phos_mode
    phos_mode="$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/Vault.OS/terminal-phosphor" 2>/dev/null || echo reduced)"
    case "$phos_mode" in full|reduced|clear) ;; *) phos_mode=reduced ;; esac
    vaultos-terminal-phosphor "$phos_mode" >/dev/null || true
  fi




  # GTK overlays always — HUD import only (spinner lives in theme gtk.css)
  overlay_src="$(_gtk_overlay_dir)"
  hud_theme="$want_t"
  case "$hud_theme" in Vault.OS|Vault.OS-Reduced) ;; *) hud_theme="Vault.OS" ;; esac
  mkdir -p "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"
  printf '%s
' \
    '/* Vault.OS user GTK overlay — import theme HUD only; never PipBoy CSS */' \
    '/* Spinner fix: theme gtk-3.0/gtk-3.20 only (no fighting user override). */' \
    "@import url(\"file://$HOME/.themes/${hud_theme}/gtk-3.0/hud.css\");" \
    > "$HOME/.config/gtk-3.0/gtk.css"
  if [[ -f "$overlay_src/gtk4.css" ]]; then
    cp -f "$overlay_src/gtk4.css" "$HOME/.config/gtk-4.0/gtk.css"
  fi


  if [[ "$bad" -eq 1 && -x "$HOME/.local/bin/vault-os-chromium-theme" ]]; then
    "$HOME/.local/bin/vault-os-chromium-theme" 2>/dev/null || true
  fi
}


cmd_ensure_qt() {
  # Qt/Kvantum: use THEME_NAME if a Kvantum skin exists; else PipBoy-NV (only Qt skin shipped)
  local kv_theme="${THEME_NAME:-Vault.OS}"
  [[ "$kv_theme" == "Vault.OS-Reduced" ]] && kv_theme="Vault.OS"
  if [[ ! -d "$HOME/.config/Kvantum/$kv_theme" ]]; then
    kv_theme="PipBoy-NV"
  fi
  log "ensure Qt/Kvantum $kv_theme (GTK/xfwm stay ${THEME_NAME:-Vault.OS})"
  mkdir -p "$HOME/.config/Kvantum" "$HOME/.config/qt5ct" "$HOME/.config/qt6ct" "$HOME/.config/environment.d"
  if [[ -f "$HOME/.config/Kvantum/kvantum.kvconfig" ]]; then
    sed -i "s/^theme=.*/theme=${kv_theme}/" "$HOME/.config/Kvantum/kvantum.kvconfig" 2>/dev/null || true
  else
    printf '[General]\ntheme=%s\n' "$kv_theme" > "$HOME/.config/Kvantum/kvantum.kvconfig"
  fi
  for qt in qt5ct qt6ct; do
    local conf="$HOME/.config/$qt/$qt.conf"
    if [[ -f "$conf" ]]; then
      sed -i 's/^style=.*/style=kvantum/' "$conf" 2>/dev/null || true
      sed -i "s/^icon_theme=.*/icon_theme=${ICON_THEME}/" "$conf" 2>/dev/null || true
    fi
  done
  write_vault_os_env
}

cmd_ensure_coverage() {
  log "ensure extended theme coverage"
  cmd_ensure_qt || true
  # sounds — Vault.OS pack if present; else mute (never force PipBoy under Vault.OS)
  if [[ -d "$HOME/.local/share/sounds/Vault.OS" ]]; then
    xq_set xsettings /Net/SoundThemeName -t string -s "Vault.OS"
    xq_set xsettings /Net/EnableEventSounds -t bool -s true
  elif [[ "${THEME_NAME:-Vault.OS}" == "PipBoy-NV" && -d "$HOME/.local/share/sounds/PipBoy-NV" ]]; then
    xq_set xsettings /Net/SoundThemeName -t string -s "PipBoy-NV"
    xq_set xsettings /Net/EnableEventSounds -t bool -s true
  else
    xq_set xsettings /Net/EnableEventSounds -t bool -s false
    if [[ "$(xq_get xsettings /Net/SoundThemeName | head -1)" == "PipBoy-NV" ]]; then
      xq_set xsettings /Net/SoundThemeName -t string -s "freedesktop"
    fi
  fi
  # chromium theme
  if [[ -x "$HOME/.local/bin/vault-os-chromium-theme" ]]; then
    "$HOME/.local/bin/vault-os-chromium-theme" 2>/dev/null || true
  fi
  # flatpak
  if have flatpak; then
    flatpak override --user --env=GTK_THEME="$THEME_NAME" 2>/dev/null || true
    flatpak override --user --env=ICON_THEME="$ICON_THEME" 2>/dev/null || true
    flatpak override --user --env=XCURSOR_THEME="${CURSOR_THEME:-Vault.OS}" 2>/dev/null || true
  fi
}

cmd_coverage() {
  local kv qt vs ff disc snd
  kv=$(grep ^theme= "$HOME/.config/Kvantum/kvantum.kvconfig" 2>/dev/null | cut -d= -f2 || true)
  qt=$(grep ^style= "$HOME/.config/qt5ct/qt5ct.conf" 2>/dev/null | cut -d= -f2 || true)
  vs=$(grep colorTheme "$HOME/.config/Code - OSS/User/settings.json" 2>/dev/null | head -1 || true)
  ff=$(ls -d "$HOME/.mozilla/firefox/"*/chrome/userChrome.css 2>/dev/null | head -1 || true)
  disc=$(ls "$HOME/.config/Vencord/themes/PipBoyNV.theme.css" \
            "$HOME/.config/BetterDiscord/themes/PipBoyNV.theme.css" 2>/dev/null | head -1 || true)
  snd=$(ls -d "$HOME/.local/share/sounds/Vault.OS" 2>/dev/null || ls -d "$HOME/.local/share/sounds/PipBoy-NV" 2>/dev/null || true)
  printf 'Vault-OS theme coverage\n'
  printf '======================\n'
  printf 'GTK:     %s\n' "$(xq_get xsettings /Net/ThemeName | head -1)"
  printf 'Icons:   %s\n' "$(xq_get xsettings /Net/IconThemeName | head -1)"
  printf 'WM:      %s\n' "$(xq_get xfwm4 /general/theme | head -1)"
  printf 'Cursor:  %s\n' "$(xq_get xsettings /Gtk/CursorThemeName | head -1)"
  printf 'Sound:   %s\n' "$(xq_get xsettings /Net/SoundThemeName | head -1)"
  printf 'Notify:  %s\n' "$(xq_get xfce4-notifyd /theme | head -1)"
  printf 'Kvantum: %s\n' "${kv:-missing}"
  printf 'qt5ct:   %s\n' "${qt:-missing}"
  printf 'VS Code: %s\n' "${vs:-unset}"
  printf 'Firefox: %s\n' "${ff:-missing}"
  printf 'Discord: %s\n' "${disc:-missing}"
  local ldm
  ldm=$(grep -E '^theme-name=' /etc/lightdm/lightdm-gtk-greeter.conf 2>/dev/null | cut -d= -f2 || true)
  if [[ "$ldm" == "Vault.OS" || "$ldm" == "Vault.OS-Reduced" || "$ldm" == "PipBoy-NV" ]]; then
    printf 'LightDM: %s OK\n' "$ldm"
  else
    printf 'LightDM: missing (run vault-os-install-system-theme)\n'
  fi
  printf 'Sounds:  %s\n' "${snd:-missing}"
}

cmd_ensure_all() {
  # Single-process integrity pass for the watch timer (no panel restart).
  log "ensure-all"
  cmd_ensure_theme || true
  cmd_ensure_coverage || true
  ensure_xfdesktop || true
  cmd_ensure_panel || true
}

cmd_session_start() {
  local lock="$LOCK_DIR/session.lock"
  exec 8>"$lock"
  if ! flock -n 8; then warn "session-start already running"; return 0; fi

  log "session-start begin v$VERSION"
  local i
  for i in $(seq 1 100); do
    xset q &>/dev/null && break
    sleep 0.05
  done

  # Wait for xfsettingsd so our theme is not overwritten by late session defaults
  local j
  for j in $(seq 1 50); do
    pgrep -x xfsettingsd >/dev/null 2>&1 && break
    sleep 0.1
  done

  cmd_apply
  ensure_xfdesktop || true
  cmd_ensure_panel
  cmd_ensure_theme
  pgrep -x xfsettingsd >/dev/null 2>&1 && killall -HUP xfsettingsd 2>/dev/null || true

  # XFCE/settings often re-assert stock "GTK"/Adwaita shortly after login — fight the race
  ( sleep 2;  load_config; cmd_ensure_theme ) >/dev/null 2>&1 &
  ( sleep 6;  load_config; cmd_ensure_theme; cmd_ensure_panel ) >/dev/null 2>&1 &
  ( sleep 15; load_config; cmd_ensure_theme; cmd_ensure_coverage ) >/dev/null 2>&1 &

  cmd_intro

  local l2
  l2=$(xq_get xfce4-panel /panels/panel-2/length | head -1)
  if _panel_num_ok "${l2:-0}" 50; then
    local live="$HOME/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml"
    local good="${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv/xfce4-panel.xml.known-good"
    [[ -f "$live" ]] && cp -a "$live" "$good"
  fi
  log "session-start complete"
}

cmd_status() {
  local ec=0
  echo "vault-os $VERSION"
  echo "───────────────"
  local t i w
  t=$(xq_get xsettings /Net/ThemeName | head -1)
  i=$(xq_get xsettings /Net/IconThemeName | head -1)
  w=$(xq_get xfwm4 /general/theme | head -1)
  printf 'theme      %s %s\n' "$t" "$([[ "$t" == "$THEME_NAME" ]] && echo OK || echo DRIFT)"
  printf 'icons      %s %s\n' "$i" "$([[ "$i" == "$ICON_THEME" ]] && echo OK || echo DRIFT)"
  printf 'wm         %s %s\n' "$w" "$([[ "$w" == "$WM_THEME" ]] && echo OK || echo DRIFT)"
  if pgrep -x xfce4-panel >/dev/null 2>&1; then
    printf 'panel      running pid=%s\n' "$(pgrep -x xfce4-panel | head -1)"
  else
    printf 'panel      DEAD\n'; ec=1
  fi
  local p1 p2 pos2
  p1=$(xq_get xfce4-panel /panels/panel-1/length | head -1)
  p2=$(xq_get xfce4-panel /panels/panel-2/length | head -1)
  pos2=$(xq_get xfce4-panel /panels/panel-2/position | head -1)
  printf 'panel-1    length=%s\n' "$p1"
  printf 'panel-2    length=%s position=%s\n' "$p2" "$pos2"
  _panel_num_ok "${p2:-0}" 50 || { printf 'panel-2    LENGTH_BAD\n'; ec=1; }
  [[ "$pos2" == *x=* ]] || { printf 'panel-2    POSITION_INCOMPLETE\n'; ec=1; }
  if [[ "${INTRO_ENABLED:-0}" == "1" && ! -f "${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv/skip-boot-intro" ]]; then
    if [[ -f "$INTRO_FILE" || -f "$HOME/.local/share/fallout-nv/FNVIntro-1080p-1m26s.mp4" ]]; then
      printf 'intro      enabled (media OK)\n'
    else
      printf 'intro      enabled (media missing)\n'
    fi
  else
    printf 'intro      disabled\n'
  fi
  [[ -d "$HOME/.themes/$THEME_NAME" ]] && printf 'theme_dir  OK\n' || { printf 'theme_dir  MISSING\n'; ec=1; }
  if [[ -d "$HOME/.local/share/icons/$ICON_THEME" || -d "$HOME/.icons/$ICON_THEME" ]]; then
    printf 'icon_dir   OK\n'
  else
    printf 'icon_dir   MISSING\n'; ec=1
  fi
  local wall_live wall_ok=0
  wall_live=$(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep 'last-image$' | head -1 || true)
  if [[ -n "$wall_live" ]]; then
    wall_live=$(xq_get xfce4-desktop "$wall_live" | head -1)
    [[ -f "$wall_live" ]] && wall_ok=1
    printf 'wallpaper  %s %s\n' "$([[ $wall_ok -eq 1 ]] && echo OK || echo MISSING)" "${wall_live##*/}"
  else
    printf 'wallpaper  unset\n'
  fi
  local cur
  cur=$(xq_get xsettings /Gtk/CursorThemeName | head -1)
  if [[ "${cur:-}" == "${CURSOR_THEME}" ]]; then
    printf 'cursor     %s OK\n' "$cur"
  else
    printf 'cursor     %s DRIFT (want %s)\n' "${cur:-none}" "${CURSOR_THEME}"
  fi
  local ntheme
  ntheme=$(xq_get xfce4-notifyd /theme | head -1)
  printf 'notify     %s\n' "${ntheme:-default}"
  if has_share_tech_mono; then
    printf 'font       Share Tech Mono OK\n'
  else
    printf 'font       Share Tech Mono MISSING\n'
  fi
  if [[ -d "$HOME/.icons/${CURSOR_THEME:-Vault.OS}/cursors" || -d "$HOME/.local/share/icons/${CURSOR_THEME:-Vault.OS}/cursors" ]]; then
    printf 'cursor_dir OK\n'
  else
    printf 'cursor_dir MISSING\n'; ec=1
  fi
  if pgrep -x picom >/dev/null 2>&1; then
    printf 'picom      running\n'
  else
    printf 'picom      not running\n'
  fi
  if pgrep -x xfdesktop >/dev/null 2>&1; then
    printf 'xfdesktop  running\n'
  else
    printf 'xfdesktop  DEAD\n'; ec=1
  fi
  if [[ -d "$HOME/.themes/$THEME_NAME/xfce-notify-4.0" ]]; then
    printf 'notify_thm OK\n'
  else
    printf 'notify_thm MISSING\n'
  fi
  return "$ec"
}


cmd_doctor() {
  log "doctor: diagnose + repair"
  cmd_apply || true
  cmd_ensure_coverage || true
  ensure_xfdesktop || true
  cmd_ensure_panel || true
  xq_set xfce4-panel /panels/panel-1/position -t string -s "$PANEL1_POSITION"
  xq_set xfce4-panel /panels/panel-2/position -t string -s "$PANEL2_POSITION"

  if pgrep -x xfce4-panel >/dev/null 2>&1; then
    local p2
    p2=$(xq_get xfce4-panel /panels/panel-2/length | head -1)
    if _panel_num_ok "${p2:-0}" 50; then
      xfce4-panel -r 2>/dev/null || true
      sleep 0.5
      xq_set xfce4-panel /panels/panel-1/position -t string -s "$PANEL1_POSITION"
      xq_set xfce4-panel /panels/panel-2/position -t string -s "$PANEL2_POSITION"
    else
      killall xfce4-panel 2>/dev/null || true
      sleep 0.5
      nohup xfce4-panel >>"${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv/panel.log" 2>&1 &
      sleep 0.8
      xq_set xfce4-panel /panels/panel-1/position -t string -s "$PANEL1_POSITION"
      xq_set xfce4-panel /panels/panel-2/position -t string -s "$PANEL2_POSITION"
    fi
  fi

  if cmd_status; then
    local live="$HOME/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml"
    local good="${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv/xfce4-panel.xml.known-good"
    [[ -f "$live" ]] && cp -a "$live" "$good" && log "snapshot panel config"
  fi
}


cmd_install() {
  # User-session install from this checkout (no sudo).
  local root here
  here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  root="$(cd "$here/.." && pwd)"
  [[ -d "$root/themes/Vault.OS" ]] || { err "run from a Vault.OS checkout (missing themes/Vault.OS)"; return 1; }

  log "install from $root"
  mkdir -p "$HOME/.themes" "$HOME/.icons" "$HOME/.local/bin" \
    "$HOME/.local/share/backgrounds/Vault.OS" \
    "$HOME/.local/share/Vault.OS" \
    "${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv"

  cp -a "$root/themes/Vault.OS" "$HOME/.themes/"
  cp -a "$root/themes/Vault.OS-Reduced" "$HOME/.themes/"
  cp -a "$root/icons/Vault.OS" "$HOME/.icons/"

  # Wallpapers / panel plates
  if [[ -d "$root/source/wallpapers" ]]; then
    cp -a "$root/source/wallpapers/." "$HOME/.local/share/backgrounds/Vault.OS/" 2>/dev/null || true
  fi
  # Lock spin frames if shipped
  if [[ -d "$root/source/lock/lock-spin-frames" ]]; then
    mkdir -p "$HOME/.local/share/backgrounds/Vault.OS/lock-spin-frames"
    cp -a "$root/source/lock/lock-spin-frames/." "$HOME/.local/share/backgrounds/Vault.OS/lock-spin-frames/"
  elif [[ -d "$HOME/.local/share/backgrounds/Vault.OS/lock-spin-frames" ]]; then
    :
  fi

  # Terminal theme + scanline asset
  if [[ -d "$root/source/xfce4-terminal" ]]; then
    mkdir -p "$HOME/.config/xfce4/terminal"              "$HOME/.local/share/xfce4/terminal/colorschemes"              "$HOME/.local/share/Vault.OS"
    [[ -f "$root/source/xfce4-terminal/terminalrc" ]] &&       cp -f "$root/source/xfce4-terminal/terminalrc" "$HOME/.config/xfce4/terminal/terminalrc"
    [[ -f "$root/source/xfce4-terminal/Vault.OS.theme" ]] &&       cp -f "$root/source/xfce4-terminal/Vault.OS.theme"         "$HOME/.local/share/xfce4/terminal/colorschemes/Vault.OS.theme"
    [[ -f "$root/source/xfce4-terminal/scanline.png" ]] &&       cp -f "$root/source/xfce4-terminal/scanline.png" "$HOME/.local/share/Vault.OS/scanline.png"
    mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/Vault.OS"
    echo reduced > "${XDG_CONFIG_HOME:-$HOME/.config}/Vault.OS/terminal-phosphor"
  fi

  # Control-plane helpers
  local bin
  for bin in vault-os vaultos-lock vaultos-session-lock vaultos-spin-arch \
             vaultos-spin-lock vaultos-spin-lock-run vaultos-terminal-phosphor vaultos-watch; do
    if [[ -f "$root/bin/$bin" ]]; then
      ln -sfn "$root/bin/$bin" "$HOME/.local/bin/$bin"
      chmod +x "$root/bin/$bin" 2>/dev/null || true
    fi
  done

  # Seed conf (never leave PipBoy defaults in a Vault.OS install)
  local conf="${XDG_CONFIG_HOME:-$HOME/.config}/fallout-nv/vault-os.conf"
  if [[ ! -f "$conf" ]] || grep -qE 'THEME_NAME=PipBoy-NV|ICON_THEME=FalloutMojave' "$conf" 2>/dev/null; then
    cat >"$conf" <<EOF
# Vault.OS configuration
THEME_NAME=Vault.OS
ICON_THEME=Vault.OS
WM_THEME=Vault.OS
CURSOR_THEME=Vault.OS
CURSOR_SIZE=24
UI_FONT=Share Tech Mono 10
MONO_FONT=Share Tech Mono 10
TITLE_FONT=Share Tech Mono Bold 10
WALLPAPER=\$HOME/.local/share/backgrounds/Vault.OS/vault-111-base.png
WALLPAPER_FALLBACK=\$HOME/.local/share/backgrounds/Vault.OS/vault-111.png
PANEL1_POSITION=p=6;x=0;y=0
PANEL1_LENGTH=100
PANEL1_SIZE=28
PANEL1_AUTOHIDE=0
PANEL1_BG_IMAGE=\$HOME/.local/share/backgrounds/Vault.OS/panel-top.png
PANEL2_POSITION=p=10;x=0;y=0
PANEL2_LENGTH=100
PANEL2_SIZE=44
PANEL2_AUTOHIDE=0
PANEL2_BG_IMAGE=\$HOME/.local/share/backgrounds/Vault.OS/panel-dock.png
PANEL_BG_STYLE=2
PANEL_BG_R=0.047
PANEL_BG_G=0.059
PANEL_BG_B=0.047
PANEL_BG_A=1.0
PANEL1_ICON_SIZE=16
PANEL2_ICON_SIZE=32
INTRO_ENABLED=0
LOG_FILE=\$HOME/.local/share/fallout-nv/logs/vault-os.log
LOCK_DIR=\$XDG_RUNTIME_DIR/vault-os
EOF
    log "wrote $conf"
  fi

  export VAULT_OS_ROOT="$root"
  # Persist checkout root so ensure-theme finds source/gtk-overlay after reboot
  if grep -q '^VAULT_OS_ROOT=' "$conf" 2>/dev/null; then
    sed -i "s|^VAULT_OS_ROOT=.*|VAULT_OS_ROOT=$root|" "$conf"
  else
    printf '\nVAULT_OS_ROOT=%s\n' "$root" >>"$conf"
  fi
  # Seed GTK overlays from this checkout (HUD import + gtk4.css)
  mkdir -p "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"
  printf '%s\n' \
    '/* Vault.OS user GTK overlay — import theme HUD only; never legacy neon */' \
    "@import url(\"file://$HOME/.themes/Vault.OS/gtk-3.0/hud.css\");" \
    > "$HOME/.config/gtk-3.0/gtk.css"
  if [[ -f "$root/source/gtk-overlay/gtk4.css" ]]; then
    cp -f "$root/source/gtk-overlay/gtk4.css" "$HOME/.config/gtk-4.0/gtk.css"
  fi
  # Prefer ~/.local/bin copy
  export PATH="$HOME/.local/bin:$PATH"
  load_config
  cmd_apply || true
  cmd_ensure_theme || true
  log "user install done — Appearance/WM should show Vault.OS"
  log "screensaver system binary (optional sudo): $root/source/xfce4-screensaver/install-system.sh"
  cmd_status || true
}


cmd_selftest() {
  log "selftest"
  local fail=0
  [[ -x "$HOME/.local/bin/vault-os" ]] || { err "vault-os not executable"; fail=1; }
  [[ -f "$CONF_DEFAULT" ]] || { err "missing conf"; fail=1; }
  [[ -d "$HOME/.themes/$THEME_NAME" ]] || { err "theme dir"; fail=1; }
  have xfconf-query || { err "xfconf-query missing"; fail=1; }
  have mpv || warn "mpv missing"
  if cmd_status; then log "selftest PASS"; else warn "selftest issues — run: vault-os doctor"; fail=1; fi
  return "$fail"
}

usage() {
  printf '%s\n' \
    "vault-os ${VERSION} — Vault.OS XFCE control plane" \
    '' \
    '  session-start   Login orchestrator (theme → panel → intro)' \
    '  apply           Apply theme, icons, cursor, panels' \
    '  ensure-panel    Repair/restore both panels' \
    '  ensure-desktop  Keep xfdesktop running (does not change wallpaper)' \
    '  ensure-theme    Re-assert Vault.OS GTK/icons/wm/panel if drifted' \
    '  ensure-qt       Kvantum + qt5ct/qt6ct (Vault.OS GTK; Qt skin if present)' \
    '  ensure-coverage Qt/sounds/flatpak/chromium theme extras' \
    '  ensure-all      Theme + coverage + desktop + panel (watch timer)' \
    '  coverage        Print theme integration coverage report' \
    '  doctor          Diagnose + full repair' \
    '  intro           Play boot intro now' \
    '  intro-enable    Enable intro on login' \
    '  intro-disable   Disable intro on login' \
    '  status          Health check (exit 1 if unhealthy)' \
    '  install         Copy themes/icons/helpers into ~/.themes ~/.icons ~/.local' \
    '  selftest        Validate installation' \
    '  version         Print version' \
    '' \
    "Config: ${CONF_DEFAULT}"
}

main() {
  load_config
  local cmd="${1:-status}"
  case "$cmd" in
    session-start|session) cmd_session_start ;;
    apply|theme)           cmd_apply; cmd_ensure_panel; cmd_ensure_coverage ;;
    ensure-panel|panel)    cmd_ensure_panel ;;
    ensure-desktop|desktop|xfdesktop) cmd_ensure_desktop ;;
    ensure-theme|theme-guard) cmd_ensure_theme ;;
    install) cmd_install ;;
    ensure-qt)             cmd_ensure_qt ;;
    ensure-coverage)       cmd_ensure_coverage ;;
    ensure-all)            cmd_ensure_all ;;
    coverage)              cmd_coverage ;;
    doctor|repair|fix)   cmd_doctor; cmd_status ;;
    intro|play-intro)      cmd_intro ;;
    intro-enable|enable)   cmd_intro_enable ;;
    intro-disable|disable) cmd_intro_disable ;;
    status|st)             cmd_status ;;
    selftest|test)         cmd_selftest ;;
    version|-V|--version)  echo "vault-os $VERSION" ;;
    -h|--help|help)        usage ;;
    *)                     usage; exit 2 ;;
  esac
}

main "$@"
