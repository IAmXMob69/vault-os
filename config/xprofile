# Vault-OS session environment only (no UI side effects)
export QT_QPA_PLATFORMTHEME=qt5ct
export EDITOR=nvim
export VISUAL=nvim
export BROWSER=firefox
export PATH="$HOME/.local/bin:$PATH"
# Intel HD 630: iHD for VA-API, EGL so Firefox can hardware-decode on X11
export LIBVA_DRIVER_NAME=iHD
export LIBVA_DRIVERS_PATH=/usr/lib/dri
export MOZ_X11_EGL=1
# HDMI mode/range is owned by vault-os-display (autostart). Do not force 60 Hz here.
