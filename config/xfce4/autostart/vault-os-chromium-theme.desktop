[Desktop Entry]
Type=Application
Name=Vault-OS Chromium Theme
Comment=Force Pip-Boy Chromium theme after login
Exec=@HOME@/.local/bin/vault-os-chromium-theme
Icon=chromium
Terminal=false
X-GNOME-Autostart-enabled=false
X-GNOME-Autostart-Delay=4
StartupNotify=false
OnlyShowIn=XFCE;
Hidden=true
# ensure-theme / ensure-all already apply the Chromium theme.
