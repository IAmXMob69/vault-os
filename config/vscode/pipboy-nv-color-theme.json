  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#1A4A2A", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#5CFF9A" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#FFB000" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#33FF6A", "fontStyle": "bold" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#B8FFCC" } },
    { "scope": ["entity.name.class", "entity.name.type", "support.class"], "settings": { "foreground": "#C8FFD8" } },
    { "scope": ["variable", "variable.other"], "settings": { "foreground": "#33FF6A" } },
    { "scope": ["invalid"], "settings": { "foreground": "#FF4D4D" } }
  ]
}
