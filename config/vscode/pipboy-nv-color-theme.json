  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#0C4C23", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#66FF9C" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#FFB000" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#1AFF6B", "fontStyle": "bold" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#B6FFD0" } },
    { "scope": ["entity.name.class", "entity.name.type", "support.class"], "settings": { "foreground": "#C7FFDA" } },
    { "scope": ["variable", "variable.other"], "settings": { "foreground": "#1AFF6B" } },
    { "scope": ["invalid"], "settings": { "foreground": "#FF4D4D" } }
  ]
}
