[%General]
author=Vault-OS
comment=Pip-Boy 3000 / Fallout NV dark phosphor Qt theme
left_tabs=true
attach_active_tab=true
group_toolbar_buttons=true
spread_progressbar=true
progressbar_thickness=6
composite=true
menu_shadow_depth=5
spread_menuitems=true
tooltip_shadow_depth=4
slider_width=4
slider_handle_width=16
slider_handle_length=12
scroll_min_extent=48
x11drag=all
menubar_mouse_tracking=true
toolbutton_style=0
click_behavior=0
translucent_windows=false
blurring=false
merge_menubar_with_toolbar=false
scroll_arrows=false
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=16
animate_states=true
combo_as_lineedit=true
combo_menu=true
groupbox_top_label=true
inline_spin_indicators=true
joined_inactive_tabs=true
transient_scrollbar=true
layout_spacing=4
tooltip_delay=-1
check_size=16

[GeneralColors]
window.color=#070C09
base.color=#0A100C
alt.base.color=#0D1510
button.color=#0D1510
light.color=#0D5E2A
mid.light.color=#0F7835
dark.color=#040806
mid.color=#121C15
highlight.color=#0D5E2A
inactive.highlight.color=#0B3B1C
text.color=#1AFF6B
window.text.color=#1AFF6B
button.text.color=#1AFF6B
disabled.text.color=#0C4C23
tooltip.text.color=#B6FFD0
highlight.text.color=#B6FFD0
link.color=#66FF9C
link.visited.color=#129D43
progress.indicator.text.color=#070C09

[Hacks]
respect_darkness=true
transparent_dolphin_view=false
blur_translucent=false
transparent_ktitle_label=true
transparent_menutitle=false
force_size_grip=true
disabled_icon_opacity=70
iconless_menu=false
iconless_pushbutton=false
