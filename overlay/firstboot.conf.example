# Copy to /etc/vaultos/firstboot.conf for unattended first boot:
#   install -m 0600 -o root -g root firstboot.conf /etc/vaultos/firstboot.conf
# Must be root:root 0600 (looser is tightened with a warning; symlinks and
# non-root owners are ignored). Shredded after a successful first boot.
# Also accepted via kernel cmdline: vaultos.firstboot=/etc/vaultos/firstboot.conf
# Skip the wizard entirely: vaultos.firstboot=skip
#
# hostname=vaultos
# timezone=UTC
# locale=en_US.UTF-8
# keymap=us
# username=alice
# password=change-me
# skip_wifi=1
# wifi_ssid=
# wifi_psk=
