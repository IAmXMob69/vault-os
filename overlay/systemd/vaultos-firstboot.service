[Unit]
Description=Vault.OS first-boot identity (os-release), before the wizard
Documentation=https://github.com/IAmXMob69/vault-os
# Identity apply is once. The interactive wizard writes firstboot-done.
ConditionPathExists=!/var/lib/vaultos/identity-applied
After=local-fs.target
Before=vaultos-firstuser.service vaultos-core.service
# Do not Require= this from graphical.target. Failure must not block LightDM.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/vaultos/libexec/vaultos-firstboot.sh
Nice=10
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
