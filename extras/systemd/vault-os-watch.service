[Unit]
Description=Vault-OS desktop+panel+theme integrity check
After=graphical-session.target

[Service]
Type=oneshot
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
ExecStart=%h/.local/bin/vault-os ensure-theme
ExecStart=%h/.local/bin/vault-os ensure-coverage
ExecStart=%h/.local/bin/vault-os ensure-desktop
ExecStart=%h/.local/bin/vault-os ensure-panel
Nice=10
